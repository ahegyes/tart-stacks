# PHP build dependencies (Fedora/dnf names), one or more per line; '#' comments and
# blank lines ignored. Each provides headers for a --with-X configure flag or a PECL
# extension. Installs go through pkg_install_optional, which warns on a missing
# package instead of failing; the smoke gate in scripts/linux/mise-install.sh is what catches a
# dropped capability — pair list changes with gate changes. Equivalent capabilities
# to packages.apt (names differ); keep both and PHP_CONFIGURE_OPTIONS aligned.

# Build toolchain
re2c bison autoconf automake libtool pkgconf
# Core compile deps
openssl-devel libxml2-devel
# pdo_sqlite, sqlite3
sqlite-devel
# mbstring
oniguruma-devel
# intl (ICU)
libicu-devel
# curl
libcurl-devel
# zip
libzip-devel
# gd + JPEG/PNG/WebP/XPM/AVIF/FreeType (gd-devel is load-bearing: --with-external-gd)
gd-devel libpng-devel libjpeg-turbo-devel libwebp-devel libXpm-devel libavif-devel freetype-devel
# sodium
libsodium-devel
# readline
readline-devel
# bz2
bzip2-devel
# PHP-FPM systemd notify
systemd-devel
# pdo_pgsql
libpq-devel
# PECL imagick (runtime + headers)
ImageMagick ImageMagick-devel
# PECL memcached
libmemcached-devel
