#!/usr/bin/env bash
# tart-ssh-sync — generate ~/.ssh/config.d/tart-vms.
#
# Usage:
#   tart-ssh-sync             # rewrite ~/.ssh/config.d/tart-vms
#   tart-ssh-sync --dry-run   # print the config that would be written to stdout
#
# The generated config has three layers:
#   1. A `Host tart-*` wildcard block applied to every Tart dev VM (present
#      or future): User, IdentityAgent (for logging INTO the VM, via Secretive),
#      ProxyCommand (live IP resolution via `tart ip`), host-key handling, and
#      an auto-start Match hook that boots a stopped VM on interactive login.
#   2. Per-VM Host blocks generated from ~/.config/tart-stacks/ssh-agents
#      (some external owner writes this file from its own source of truth;
#      tart-stacks just consumes). Each VM listed in that file gets a
#      Host tart-<name> block carrying:
#        - ForwardAgent <host-side-socket-path>
#          The PRIMARY agent (first listed for this VM) becomes the VM's
#          $SSH_AUTH_SOCK once sshd accepts the session.
#        - One RemoteForward per ADDITIONAL agent, exposing that agent's host
#          socket at /run/tart/agent-<name>.sock inside the VM. Per-host SSH
#          config in the VM uses IdentityAgent to pick the right agent per
#          target host (only relevant for multi-agent VMs; single-agent VMs
#          just use $SSH_AUTH_SOCK from the ForwardAgent above).
#   3. Personal forwards from ~/.config/tart-stacks/forwards:
#      `<vm-pattern> RemoteForward <args>` accumulating per VM.
#
# A VM absent from ssh-agents gets NO agent forwarded — fail-closed by absence.
# This matches the contract: signing requires an agent socket forwarded to
# the VM, and an unassigned VM has nothing forwarded so it can't sign.
#
# One-time host setup (done by `make setup`):
#   Add to the top of ~/.ssh/config, ABOVE any `Host *` block:
#     Include ~/.ssh/config.d/tart-vms
#
# Overridable via env:
#   TART_SSH_AGENTS      VM-agent assignment file. Default: $HOME/.config/tart-stacks/ssh-agents
#   TART_FORWARDS        forwards config file.     Default: $HOME/.config/tart-stacks/forwards
#   TART_SSH_CONFIG_D    output file.              Default: $HOME/.ssh/config.d/tart-vms
#   TART_IDENTITY_AGENT  Secretive agent socket.   Default: $HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh
#   TART_NC_BIN          nc baked into the ProxyCommand. Default: /usr/bin/nc
#   TART_VM_USER         in-VM login user.         Default: admin (match the build's -var ssh_username)

set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

OUTPUT="${TART_SSH_CONFIG_D:-$HOME/.ssh/config.d/tart-vms}"
SSH_AGENTS_CONFIG=$(tart_config_path ssh-agents)
FORWARDS_CONFIG=$(tart_config_path forwards)
IDENTITY_AGENT="${TART_IDENTITY_AGENT:-$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh}"
# The build parameterizes the guest account (`-var ssh_username`); this is the
# host half of the same knob, so a non-default build stays reachable by name.
VM_USER="${TART_VM_USER:-admin}"

usage() {
  echo "usage: $prog [--dry-run]" >&2
}

DRY_RUN=0
case "${1:-}" in
  --dry-run|-n) DRY_RUN=1 ;;
  -h|--help)    usage; exit 0 ;;
  '') ;;
  *) echo "$prog: unknown arg '$1'" >&2; usage; exit 64 ;;
esac

tart_need_cmd tart "Install: brew install openai/tools/tart"

# Resolve tart-up to an absolute path for the generated Match line (the Match
# exec runs under a GUI/non-login shell that may lack ~/.local/bin on PATH).
# Prefer the installed ~/.local/bin handle; fall back to this checkout's sibling
# (SCRIPT_DIR resolved at the top) for a dev/CI run from the repo.
TART_UP_BIN="$(command -v tart-up 2>/dev/null || true)"
[ -n "$TART_UP_BIN" ] || TART_UP_BIN="$SCRIPT_DIR/tart-up"

# Absolute paths baked into the generated ProxyCommand: GUI SSH clients
# (JetBrains Gateway, VS Code) launch with a minimal PATH and can't resolve bare
# `tart`/`nc`. tart is resolved here so the script itself stays host-portable.
TART_BIN="$(command -v tart)"
# BSD nc's -G is the baked connect bound; a PATH-shadowing GNU netcat parses
# -G as a no-op, so pin the system binary (TART_NC_BIN is the test seam).
NC_BIN="${TART_NC_BIN:-/usr/bin/nc}"

# Parse the forwards config into parallel arrays preserving line order.
# Skip blanks/comments; skip non-RemoteForward directives with a warning
# (the parser only supports RemoteForward today — extend here if needed).
patterns=()
forwards_args=()
if [ -f "$FORWARDS_CONFIG" ]; then
  lineno=0
  while IFS= read -r raw || [ -n "$raw" ]; do
    lineno=$((lineno + 1))
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    directive="${rest%%[[:space:]]*}"
    if [ "$directive" != "RemoteForward" ]; then
      echo "$prog: $FORWARDS_CONFIG:$lineno: skipping unsupported directive '$directive' (only RemoteForward today)" >&2
      continue
    fi
    # A directive with nothing after it would emit a bare `RemoteForward` —
    # an OpenSSH fatal that takes the whole generated file down with it.
    if [ "$rest" = "$directive" ]; then
      echo "$prog: $FORWARDS_CONFIG:$lineno: skipping 'RemoteForward' with no arguments" >&2
      continue
    fi
    # The pattern grammar is exactly `*` | <name> | <a>,<b>,… — a partial glob
    # like `app-*` would land verbatim in the emitted Host line, where OpenSSH
    # treats it as a live wildcard and silently widens the forward to every
    # matching VM. Enforce the documented grammar instead.
    if [ "$pattern" != "*" ]; then
      pattern_ok=1
      IFS=',' read -r -a pat_names <<< "$pattern"
      [ "${#pat_names[@]}" -gt 0 ] || pattern_ok=0
      for pat_n in "${pat_names[@]}"; do
        tart_valid_vm_name "$pat_n" || { pattern_ok=0; break; }
      done
      if [ "$pattern_ok" -ne 1 ]; then
        echo "$prog: $FORWARDS_CONFIG:$lineno: pattern '$pattern' is not '*', a bare VM name, or a comma list of them — skipping: $raw" >&2
        continue
      fi
    fi

    patterns+=("$pattern")
    forwards_args+=("$rest")
  done < "$FORWARDS_CONFIG"
fi

# Parse the ssh-agents config into parallel (vm, agent, socket) arrays
# preserving line order. Each line is `<vm-name> <agent-name> <host-socket>`;
# a VM with N agents has N lines (the first one is the primary — ForwardAgent
# target — and the rest become RemoteForwards at /run/tart/agent-<name>.sock
# paths inside the VM). The host-side socket path is supplied per line so
# tart-stacks doesn't hardcode any caller's path convention; whoever writes
# the file decides where their agent sockets live. Blanks and `#` comments
# are tolerated (including any marker lines the writer uses for managed-block
# bookkeeping).
ssh_agents_vms=()
ssh_agents_names=()
ssh_agents_sockets=()
if [ -f "$SSH_AGENTS_CONFIG" ]; then
  lineno=0
  while IFS= read -r raw || [ -n "$raw" ]; do
    lineno=$((lineno + 1))
    line="${raw%%#*}"
    # The fourth field is a sink: anything landing in it means >3 tokens,
    # which would otherwise glue into the socket and emit a malformed line.
    IFS=$' \t' read -r vm agent socket extra <<< "$line"
    [ -z "$vm" ] && continue
    if [ -z "$agent" ] || [ -z "$socket" ]; then
      echo "$prog: $SSH_AGENTS_CONFIG:$lineno: malformed line (want '<vm> <agent> <host-socket>'), skipping: $raw" >&2
      continue
    fi
    if [ -n "$extra" ]; then
      echo "$prog: $SSH_AGENTS_CONFIG:$lineno: extra token(s) '$extra' after the host-socket (want '<vm> <agent> <host-socket>'), skipping: $raw" >&2
      continue
    fi
    # Bare names only — this file has no pattern grammar, by contract: agent
    # forwarding is fail-closed by absence, and the VM token lands verbatim in
    # `Host tart-<vm>`, so a pattern token (`*`, a comma list) would grant an
    # agent to VMs never listed here. The agent token gets the same gate — it
    # names the in-VM socket path /run/tart/agent-<name>.sock.
    if ! tart_valid_vm_name "$vm"; then
      echo "$prog: $SSH_AGENTS_CONFIG:$lineno: VM token '$vm' is not a bare name, skipping: $raw" >&2
      continue
    fi
    if ! tart_valid_vm_name "$agent"; then
      echo "$prog: $SSH_AGENTS_CONFIG:$lineno: agent token '$agent' is not a bare name, skipping: $raw" >&2
      continue
    fi
    ssh_agents_vms+=("$vm")
    ssh_agents_names+=("$agent")
    ssh_agents_sockets+=("$socket")
  done < "$SSH_AGENTS_CONFIG"
fi

emit() {
  echo "# Generated by tart-ssh-sync. Do not edit — re-run the script instead."
  echo "# Source of truth: this script + $SSH_AGENTS_CONFIG + $FORWARDS_CONFIG"
  echo

  echo "# Common settings — every Tart dev VM (present or future)."
  echo "Host tart-*"
  echo "  User $VM_USER"
  echo "  IdentityAgent $IDENTITY_AGENT"
  echo "  IdentityFile ~/.ssh/tart-vm.pub"
  echo "  IdentitiesOnly yes"
  # accept-new into a dedicated known_hosts: trust-on-first-use, then block on a
  # changed key (catches a substituted endpoint). Every clone's first boot gives
  # it a distinct key; tart-new clears the stale entry on recreate so the new
  # key re-accepts.
  echo "  UserKnownHostsFile ~/.ssh/known_hosts.tart"
  echo "  StrictHostKeyChecking accept-new"
  echo "  LogLevel ERROR"
  # Session liveness: the host->VM hop has no keepalive of its own, and a Tart
  # crash (an Apple Virtualization.framework vsock trap) drops every VM session
  # at once. Probing a quiet link makes a dead VM exit fast and clean (~45s =
  # 3x15s) instead of lingering half-open and erroring only as "broken pipe" on
  # the next write. The VM image sets no ClientAliveInterval, so the client owns
  # this.
  echo "  ServerAliveInterval 15"
  echo "  ServerAliveCountMax 3"
  # Live IP resolution for every client. %n (the alias) not %h: a client that
  # sets `-o HostName=<ip>` would poison %h, but %n is always the typed alias.
  # Passed as $1 (not interpolated into the script body); a stopped VM yields no
  # IP, so fail fast with a clear "run tart-up" message. The guard is for the
  # DIAGNOSTIC, not for nc's exit status: nc does fail on an empty or unreachable
  # host (measured: rc=1 for an unresolvable name and for a closed port), but it
  # fails by closing the ProxyCommand's stdout with nothing written, and ssh
  # reports that as "Connection closed by UNKNOWN port 65535" — which names
  # neither the VM nor the reason. `nc -G 5` bounds the *connect* so a stale/unreachable
  # IP fails fast (~5s). Do NOT add `nc -w`: it also closes an *idle established*
  # connection, silently killing interactive sessions ~10s after they go quiet
  # ("closed by remote host" / broken-pipe). SSH keepalives own session liveness.
  echo "  ProxyCommand /bin/sh -c 'n=\${1#tart-}; ip=\$(\"$TART_BIN\" ip \"\$n\" 2>/dev/null) && [ -n \"\$ip\" ] || { echo \"tart-vm: \$n is not running. Start it: tart-up \$n\" >&2; exit 1; }; exec $NC_BIN -G 5 \"\$ip\" 22' _ %n"
  echo
  # ( : </dev/tty ), not [ -t 0 ]: ssh runs Match-exec commands with stdin
  # already redirected to /dev/null, so a stdin test would never pass and
  # auto-start would silently die everywhere.
  echo "# Auto-start a stopped VM on interactive login only. sessiontype short-"
  echo "# circuits the exec, so git/rsync (exec), sftp (subsystem) and \`ssh -N\`"
  echo "# (none) never trigger it. The /dev/tty gate skips contexts with no"
  echo "# controlling terminal (IDE config scans, automation) — those pre-warm"
  echo "# with tart-up instead."
  echo "Match host tart-* sessiontype shell exec \"/bin/sh -c '( : </dev/tty ) 2>/dev/null && exec \\\"\$1\\\" \\\"\$2\\\"' _ '$TART_UP_BIN' %n\""

  # One Host block per VM declared in ssh-agents, preserving first-seen order.
  # PRIMARY agent (first listed for this VM) becomes ForwardAgent — sshd sets
  # $SSH_AUTH_SOCK from it in every session, so in-VM git/ssh just works.
  # ADDITIONAL agents become RemoteForwards at /run/tart/agent-<name>.sock so
  # multi-agent VMs can route per-host via IdentityAgent (single-agent VMs
  # don't need that — they just read $SSH_AUTH_SOCK).
  if [ "${#ssh_agents_vms[@]}" -gt 0 ]; then
    local seen="|"
    local i j vm agent socket primary_socket count
    for i in "${!ssh_agents_vms[@]}"; do
      vm="${ssh_agents_vms[$i]}"
      case "$seen" in
        *"|$vm|"*) continue ;;
      esac
      seen+="$vm|"

      # Collect this VM's primary (first-listed) socket + count.
      primary_socket=""
      count=0
      for j in "${!ssh_agents_vms[@]}"; do
        if [ "${ssh_agents_vms[$j]}" = "$vm" ]; then
          count=$((count + 1))
          if [ -z "$primary_socket" ]; then
            primary_socket="${ssh_agents_sockets[$j]}"
          fi
        fi
      done

      echo
      printf '# VM %q: %d agent' "$vm" "$count"
      [ "$count" -ne 1 ] && printf 's'
      printf '\n'
      echo "Host tart-$vm"
      echo "  ForwardAgent $primary_socket"
      # These paths are fixed, so a socket outlives the session that bound it and blocks the next connection's
      # forward. ForwardAgent needs no equivalent: sshd picks a fresh path per session.
      [ "$count" -gt 1 ] && echo "  StreamLocalBindUnlink yes"
      # Additional agents — skip the primary on this pass.
      local first_seen=0
      for j in "${!ssh_agents_vms[@]}"; do
        if [ "${ssh_agents_vms[$j]}" = "$vm" ]; then
          if [ "$first_seen" -eq 0 ]; then
            first_seen=1
            continue
          fi
          agent="${ssh_agents_names[$j]}"
          socket="${ssh_agents_sockets[$j]}"
          echo "  RemoteForward /run/tart/agent-${agent}.sock $socket"
        fi
      done
    done
  fi

  # One Host block per unique vm-pattern from the forwards config,
  # preserving first-seen order. Forwards sharing a pattern group together.
  if [ "${#patterns[@]}" -gt 0 ]; then
    local seen="|"
    for i in "${!patterns[@]}"; do
      local pattern="${patterns[$i]}"
      case "$seen" in
        *"|$pattern|"*) continue ;;
      esac
      seen+="$pattern|"

      local host_list
      host_list=$(tart_resolve_pattern "$pattern")
      [ -z "$host_list" ] && continue

      echo
      echo "# Forwards for pattern: $pattern"
      echo "Host $host_list"
      local j
      for j in "${!patterns[@]}"; do
        if [ "${patterns[$j]}" = "$pattern" ]; then
          echo "  ${forwards_args[$j]}"
        fi
      done
    done
  fi
}

# config_valid <file> — 0 iff ssh parses <file> as a complete ssh_config.
# `ssh -G` reads and validates the whole file without ever connecting; -F
# keeps the user's real config out of the parse. The probe host must NOT
# match tart-* — Match short-circuits on the host criterion, so the
# auto-start exec hook cannot fire during validation.
config_valid() {
  ssh -G -F "$1" syntax-probe.invalid >/dev/null 2>&1
}

if [ "$DRY_RUN" -eq 1 ]; then
  emit
  exit 0
fi

# The emitted Match hook needs OpenSSH ≥ 10.0 (`Match sessiontype`); on older
# ssh the keyword is a fatal parse error, so activating the file would take
# down every ssh on this host at once. Refuse with the requirement named —
# --dry-run above stays available for inspection on any version.
if ! tart_ssh_has_sessiontype; then
  echo "$prog: this ssh cannot parse 'Match sessiontype' (OpenSSH >= 10.0 required — check ssh -V; current macOS updates ship it). Refusing to write $OUTPUT." >&2
  exit 1
fi

mkdir -p "$(dirname "$OUTPUT")"
tmp=$(mktemp "${OUTPUT}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
emit > "$tmp"
# The output is Included by the global ssh config, so one malformed line
# breaks every ssh/scp/git on the host. Gate activation on a full ssh parse;
# on failure keep the live file as-is and preserve the candidate for
# inspection (the mv also takes it out of the EXIT trap's reach).
if ! config_valid "$tmp"; then
  mv "$tmp" "${OUTPUT}.rejected"
  echo "$prog: generated config failed ssh -G validation — kept at ${OUTPUT}.rejected; $OUTPUT left untouched." >&2
  exit 1
fi
mv "$tmp" "$OUTPUT"
chmod 600 "$OUTPUT"
# A healthy sync supersedes any earlier rejected candidate — drop it so a
# stale .rejected can't outlive the failure it documented.
rm -f "${OUTPUT}.rejected"
trap - EXIT

if [ "${#ssh_agents_vms[@]}" -gt 0 ]; then
  vm_count=$(printf '%s\n' "${ssh_agents_vms[@]}" | sort -u | wc -l | tr -d ' ')
else
  vm_count=0
fi
echo "$prog: wrote $OUTPUT ($vm_count per-VM agent block(s), ${#patterns[@]} extra forward line(s))" >&2
