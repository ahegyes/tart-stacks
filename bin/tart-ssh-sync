#!/usr/bin/env bash
# tart-ssh-sync — generate ~/.ssh/config.d/tart-vms.
#
# Usage:
#   tart-ssh-sync             # rewrite ~/.ssh/config.d/tart-vms
#   tart-ssh-sync --dry-run   # print the config that would be written to stdout
#
# The generated config is a `tart-*` wildcard, so it applies to every Tart dev
# VM — present or future — with no per-VM enumeration. A freshly cloned VM is
# reachable as `ssh tart-<name>` immediately; you only re-run this after editing
# your forwards file (below).
#
# What it emits unconditionally (universal Tart VM defaults), under `Host tart-*`:
#   - Common block: User=admin, Secretive agent + pinned identity (IdentityAgent
#     + IdentityFile + IdentitiesOnly), host-key handling, and a ProxyCommand
#     that resolves each VM's current IP via `tart ip` at connect time — so plain
#     ssh, JetBrains Gateway, VS Code, rsync, and git all reach a *running* VM
#     by name.
#   - An auto-start hook:
#       Match host tart-* sessiontype shell exec "<abs>/tart-up %n"
#     It starts a *stopped* VM (and waits for it) on an interactive
#     `ssh tart-<name>`, and only then — git/rsync (exec), sftp (subsystem), and
#     `ssh -N` (none) don't trigger it, so tools never accidentally boot a VM.
#   - Agent socket forward for every dev VM:
#       RemoteForward /home/admin/.ssh/forwarded-agent.sock $TART_AGENT_SOCKET
#     The in-VM ~/.zshrc auto-sets SSH_AUTH_SOCK to the forwarded socket so
#     git/ssh inside the VM transparently use the host agent.
#
# What you opt into (your personal forwards): ~/.config/tart-stacks/forwards
#   Each non-blank, non-comment line:
#     <vm-pattern> RemoteForward <args...>
#   <vm-pattern>:
#     *                 — every dev VM (emitted as `Host tart-*`)
#     <name>            — single VM (bare name; emitted as `Host tart-<name>`)
#     <a>,<b>,...       — comma-separated list (no spaces)
#   A forward for a VM that doesn't exist yet is harmless — it simply applies
#   once that VM is cloned.
#
# One-time host setup (done by `make setup`):
#   Add to the top of ~/.ssh/config, ABOVE any `Host *` block (so the specific
#   tart settings beat the catch-all):
#     Include ~/.ssh/config.d/tart-vms
#
# Overridable via env:
#   TART_AGENT_SOCKET    host SSH agent socket forwarded into VMs.
#                        Default: $SSH_AUTH_SOCK (whatever your shell is wired to).
#   TART_FORWARDS        forwards config file. Default: $HOME/.config/tart-stacks/forwards
#   TART_SSH_CONFIG_D    output file. Default: $HOME/.ssh/config.d/tart-vms

set -euo pipefail

OUTPUT="${TART_SSH_CONFIG_D:-$HOME/.ssh/config.d/tart-vms}"
FORWARDS_CONFIG="${TART_FORWARDS:-$HOME/.config/tart-stacks/forwards}"
AGENT_SOCKET="${TART_AGENT_SOCKET:-${SSH_AUTH_SOCK:-}}"
if [ -z "$AGENT_SOCKET" ]; then
  echo "tart-ssh-sync: no SSH agent socket resolvable. Set \$SSH_AUTH_SOCK in your shell or pass TART_AGENT_SOCKET=<path> when invoking." >&2
  exit 1
fi

# Warn (non-fatal) if the resolved agent holds no keys: it still gets forwarded
# into every VM, where in-VM git/ssh then fail with an opaque 'Permission denied
# (publickey)'. $SSH_AUTH_SOCK often points at an empty agent (e.g. macOS's
# launchd one) unless you've added keys — set TART_AGENT_SOCKET to one with keys.
if command -v ssh-add >/dev/null 2>&1 \
  && ! SSH_AUTH_SOCK="$AGENT_SOCKET" ssh-add -l >/dev/null 2>&1; then
  echo "tart-ssh-sync: warning: agent at '$AGENT_SOCKET' has no identities (or is unreachable); VMs will forward an empty agent and in-VM git/ssh will fail. Run 'ssh-add -l', or set TART_AGENT_SOCKET to an agent with keys." >&2
fi

DRY_RUN=0
case "${1:-}" in
  --dry-run|-n) DRY_RUN=1 ;;
  '') ;;
  *) echo "tart-ssh-sync: unknown arg '$1' (use --dry-run or no args)" >&2; exit 64 ;;
esac

command -v tart >/dev/null 2>&1 || { echo "tart-ssh-sync: 'tart' not on PATH. brew install cirruslabs/cli/tart" >&2; exit 1; }

# Resolve tart-up to an absolute path for the generated Match line (the Match
# exec runs under the user's shell, which for a GUI client or non-login shell
# may lack ~/.local/bin on PATH). Resolve it like tart/nc below — via
# `command -v`, i.e. its installed ~/.local/bin handle, so the config tracks the
# install rather than this repo's path. Fall back to the sibling in this
# checkout only when tart-up isn't installed yet (a dev/CI run from the repo);
# the symlink-follow yields that fallback path.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
TART_UP_BIN="$(command -v tart-up 2>/dev/null || true)"
[ -n "$TART_UP_BIN" ] || TART_UP_BIN="$SCRIPT_DIR/tart-up"

# Absolute paths baked into the generated ProxyCommand: GUI SSH clients
# (JetBrains Gateway, VS Code) launch with a minimal PATH and can't resolve bare
# `tart`/`nc`. Resolved here so the script itself stays host-portable.
TART_BIN="$(command -v tart)"
NC_BIN="$(command -v nc || echo /usr/bin/nc)"

# Parse the forwards config into parallel arrays preserving line order.
# Skip blanks/comments; skip non-RemoteForward directives with a warning
# (the parser only supports RemoteForward today — extend here if needed).
patterns=()
forwards_args=()
if [ -f "$FORWARDS_CONFIG" ]; then
  lineno=0
  while IFS= read -r raw || [ -n "$raw" ]; do
    lineno=$((lineno + 1))
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    directive="${rest%%[[:space:]]*}"
    if [ "$directive" != "RemoteForward" ]; then
      echo "tart-ssh-sync: $FORWARDS_CONFIG:$lineno: skipping unsupported directive '$directive' (only RemoteForward today)" >&2
      continue
    fi

    patterns+=("$pattern")
    forwards_args+=("$rest")
  done < "$FORWARDS_CONFIG"
fi

# Resolve a vm-pattern to a space-joined list of host aliases for a `Host` line.
#   *            -> tart-*          (the wildcard; matches every dev VM)
#   <name>       -> tart-<name>
#   <a>,<b>,...  -> tart-<a> tart-<b> ...
# Names are emitted verbatim (no `tart list` check) — a forward for a VM that
# doesn't exist yet is inert until that VM is cloned.
resolve_pattern() {
  local pattern=$1
  if [ "$pattern" = "*" ]; then
    printf 'tart-*'
    return 0
  fi
  local out=""
  local -a names=()
  IFS=',' read -r -a names <<< "$pattern"
  local n
  for n in "${names[@]}"; do
    out+="${out:+ }tart-$n"
  done
  printf '%s' "$out"
}

emit() {
  echo "# Generated by tart-ssh-sync. Do not edit — re-run the script instead."
  echo "# Source of truth: this script + $FORWARDS_CONFIG"
  echo

  echo "# Common settings — every Tart dev VM (present or future)."
  echo "Host tart-*"
  echo "  User admin"
  echo "  IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
  echo "  IdentityFile ~/.ssh/tart-vm.pub"
  echo "  IdentitiesOnly yes"
  echo "  UserKnownHostsFile /dev/null"
  echo "  StrictHostKeyChecking no"
  echo "  LogLevel ERROR"
  # Live IP resolution for every client. %n (the alias) not %h: a client that
  # sets `-o HostName=<ip>` would poison %h, but %n is always the typed alias.
  echo "  ProxyCommand /bin/sh -c 'n=%n; exec $NC_BIN \$(\"$TART_BIN\" ip \"\${n#tart-}\") 22'"
  echo
  echo "# Auto-start a stopped VM on interactive login only. sessiontype short-"
  echo "# circuits the exec, so git/rsync (exec), sftp (subsystem) and \`ssh -N\`"
  echo "# (none) never trigger it — only an interactive shell does."
  echo "Match host tart-* sessiontype shell exec \"$TART_UP_BIN %n\""
  echo
  echo "# Host SSH agent forwarded into every VM."
  echo "Host tart-*"
  echo "  RemoteForward /home/admin/.ssh/forwarded-agent.sock $AGENT_SOCKET"

  # One Host block per unique vm-pattern from the forwards config,
  # preserving first-seen order. Forwards sharing a pattern group together.
  if [ "${#patterns[@]}" -gt 0 ]; then
    local seen="|"
    for i in "${!patterns[@]}"; do
      local pattern="${patterns[$i]}"
      case "$seen" in
        *"|$pattern|"*) continue ;;
      esac
      seen+="$pattern|"

      local host_list
      host_list=$(resolve_pattern "$pattern")
      [ -z "$host_list" ] && continue

      echo
      echo "# Forwards for pattern: $pattern"
      echo "Host $host_list"
      local j
      for j in "${!patterns[@]}"; do
        if [ "${patterns[$j]}" = "$pattern" ]; then
          echo "  ${forwards_args[$j]}"
        fi
      done
    done
  fi
}

if [ "$DRY_RUN" -eq 1 ]; then
  emit
  exit 0
fi

mkdir -p "$(dirname "$OUTPUT")"
tmp=$(mktemp "${OUTPUT}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
emit > "$tmp"
mv "$tmp" "$OUTPUT"
chmod 600 "$OUTPUT"
trap - EXIT

echo "tart-ssh-sync: wrote $OUTPUT (${#patterns[@]} extra forward line(s))" >&2
