#!/usr/bin/env bash
# tart-ssh (alias: tssh) — SSH into a Tart VM by name, auto-starting it if stopped.
#
# Usage:
#   tssh <vm-name> [ssh-args...]
#
# Example:
#   tssh app-a
#   tssh app-a -L 8888:localhost:8888    # any extra args forwarded to ssh
#
# How it works:
#  1. Resolves the VM by name via `tart list --format json`. Accepts the
#     name with or without a `tart-` prefix — tries the input as-given,
#     then swaps prefix state on miss. Lets the host-side SSH config carry
#     the `tart-<name>` alias (see `tart-ssh-sync`) without forcing the
#     prefix into every `tssh` invocation. Auto-starts the VM via
#     `tart run --no-graphics &` if it exists but isn't running; fails
#     fast if neither name form is found.
#  2. If just started, polls `tart ip` until a DHCP-assigned IP appears
#     (timeout 60s), then waits for SSH to respond (timeout 30s).
#  3. Sets up SSH connection multiplexing (ControlMaster) so the terminfo
#     install and the interactive session share a single authenticated
#     channel — ONE biometric prompt per tssh invocation. The preconnect
#     hook (step 4) can piggyback by using ssh with the same ControlPath.
#  4. If `$TART_PRECONNECT` (or default `~/.config/tart-stacks/preconnect`) is an
#     executable file, runs it with TSSH_VM / TSSH_IP / TSSH_CONTROL_PATH in
#     the environment before opening the interactive session. Useful for
#     per-machine setup (auth/config sync, etc.) that shouldn't live in this
#     repo. Hook failure is non-fatal — the warning prints, the session opens.
#  5. Transparently installs your local $TERM's terminfo into the VM if
#     missing (Ghostty, Alacritty, WezTerm, etc.).
#
#  Before connecting, if the VM isn't in the generated SSH config yet (a
#  fresh clone), tssh runs tart-ssh-sync first so its config block exists.
#
#  Directory mounts: if ~/.config/tart-stacks/mounts (override $TART_MOUNTS)
#  selects this VM, tssh adds the matching `--dir` virtiofs shares to the
#  `tart run` that auto-starts it. A mount attaches at boot, so it applies
#  only when tssh STARTS the VM — see dir_args_for_vm.

set -euo pipefail

prog="${0##*/}"   # "tart-ssh", or "tssh" when invoked via the alias symlink

if [ $# -lt 1 ]; then
  echo "Usage: $prog <vm-name> [ssh-args...]" >&2
  exit 64
fi

VM="$1"; shift

command -v tart >/dev/null 2>&1 || { echo "$prog: 'tart' not on PATH. Install: brew install cirruslabs/cli/tart" >&2; exit 1; }
command -v jq   >/dev/null 2>&1 || { echo "$prog: 'jq' not on PATH. Install: brew install jq" >&2; exit 1; }

# Resolve this script's real path (following symlinks) so we can find sibling
# tart-ssh-sync no matter how tssh was installed.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
if [ -x "$SCRIPT_DIR/tart-ssh-sync" ]; then
  TART_SSH_SYNC="$SCRIPT_DIR/tart-ssh-sync"
else
  TART_SSH_SYNC="$(command -v tart-ssh-sync || true)"
fi

# Query Tart for one VM's state by exact name; empty output = no such VM.
resolve_state() {
  tart list --format json 2>/dev/null \
    | jq -r --arg name "$1" '.[] | select(.Name==$name) | .State'
}

# Two-way prefix lookup: the SSH config alias is `tart-<name>` (the convention
# enforced by `tart-ssh-sync`), but Tart stores VMs under their bare name. Try
# the name as-given, then strip-or-add the prefix on miss so either form works
# at the CLI. Empty after both tries = genuinely absent, so fail fast.
STATE=$(resolve_state "$VM")
if [ -z "$STATE" ]; then
  case "$VM" in
    tart-*) ALT="${VM#tart-}" ;;
    *)      ALT="tart-$VM" ;;
  esac
  STATE=$(resolve_state "$ALT")
  if [ -z "$STATE" ]; then
    echo "$prog: VM '$VM' not found (also tried '$ALT'). Try 'tart list' or 'tart clone <base> $VM'." >&2
    exit 1
  fi
  VM="$ALT"
fi

# SSH config aliases use the `tart-<name>` prefix; force it here regardless
# of which form Tart stores the VM under. HostName is overridden via -o,
# so this only matters for Host-pattern matching in ~/.ssh/config.
SSH_HOST="tart-${VM#tart-}"

# Lazy-register: a freshly cloned VM has no block in the generated config
# yet. Write it before connecting so this run authenticates correctly.
# Non-fatal — on failure, let the ssh attempt report the cause.
SSH_CONFIG_D="${TART_SSH_CONFIG_D:-$HOME/.ssh/config.d/tart-vms}"
if [ -n "$TART_SSH_SYNC" ] && ! grep -qw "$SSH_HOST" "$SSH_CONFIG_D" 2>/dev/null; then
  echo "$prog: '$SSH_HOST' not registered yet — running tart-ssh-sync..." >&2
  "$TART_SSH_SYNC" >/dev/null || echo "$prog: tart-ssh-sync failed; using existing config." >&2
fi

# ---- per-VM directory mounts (opt-in) --------------------------------------
# Attach the virtiofs shares from ~/.config/tart-stacks/mounts (override via
# $TART_MOUNTS) that select this VM. Same pattern column as the forwards file
# (see tart-ssh-sync). A `--dir` is a boot-time attachment, so it only takes
# effect on the `tart run` below — a VM already running won't gain one.
MOUNTS_CONFIG="${TART_MOUNTS:-$HOME/.config/tart-stacks/mounts}"

# tart_pattern_matches <pattern> <bare-vm> — 0 if the vm-pattern selects this VM.
#   pattern: `*` (any) | <name> | <a>,<b>,... (comma list, no spaces).
tart_pattern_matches() {
  local pattern="$1" vm="$2"
  [ "$pattern" = "*" ] && return 0
  local -a names=()
  IFS=',' read -r -a names <<< "$pattern"
  local n
  for n in "${names[@]}"; do
    [ "$n" = "$vm" ] && return 0
  done
  return 1
}

# dir_args_for_vm <bare-vm> — print one `--dir=<name>:<path>[:ro]` per mounts
# line selecting this VM. Line format: `<vm-pattern> <host-path>[:ro]`; the
# in-VM share name is the path's basename (mounts at /mnt/shared/<basename>).
dir_args_for_vm() {
  local vm="$1"
  [ -f "$MOUNTS_CONFIG" ] || return 0
  local raw line pattern rest path ro
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    if [ -z "$rest" ]; then
      echo "${prog:-tart-ssh}: $MOUNTS_CONFIG: no path on line, skipping: $raw" >&2
      continue
    fi
    tart_pattern_matches "$pattern" "$vm" || continue
    case "$rest" in
      *:ro) ro=":ro"; path="${rest%:ro}" ;;
      *)    ro="";    path="$rest" ;;
    esac
    printf -- '--dir=%s:%s%s\n' "$(basename "$path")" "$path" "$ro"
  done < "$MOUNTS_CONFIG"
  return 0
}

# Resolve this VM's mounts once (bare name); reused by the start + warning paths.
DIR_ARGS=()
while IFS= read -r d; do
  [ -n "$d" ] && DIR_ARGS+=("$d")
done < <(dir_args_for_vm "${VM#tart-}")

if [ "$STATE" != "running" ]; then
  echo "$prog: VM '$VM' is $STATE — starting in background..." >&2
  # Build the command as one array so the empty-DIR_ARGS case is safe under
  # `set -u` on bash 3.2 (the macOS system bash).
  run_cmd=(tart run "$VM" --no-graphics)
  [ "${#DIR_ARGS[@]}" -gt 0 ] && run_cmd+=("${DIR_ARGS[@]}")
  ( "${run_cmd[@]}" >/dev/null 2>&1 & disown )

  # Poll for IP (DHCP usually assigns within ~5-15 s on Tart's NAT).
  IP=""
  for _ in $(seq 1 60); do
    IP=$(tart ip "$VM" 2>/dev/null) && [ -n "$IP" ] && break
    IP=""
    sleep 1
  done
  if [ -z "$IP" ]; then
    echo "$prog: VM '$VM' did not get an IP within 60 s." >&2
    exit 1
  fi
  echo "$prog: VM '$VM' at $IP — waiting for SSH..." >&2
else
  if [ "${#DIR_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — ${#DIR_ARGS[@]} configured mount(s) not attached (stop + start to apply)." >&2
  fi
  IP=$(tart ip "$VM" 2>/dev/null) || {
    echo "$prog: failed to resolve IP for running VM '$VM'." >&2
    exit 1
  }
fi

# SSH multiplexing — the first invocation becomes the master, subsequent
# invocations share it. ControlPersist keeps the master alive for 10s
# after the last slave drops, so quick bootstrap sequences only prompt once.
CONTROL_PATH=$(mktemp -u "${TMPDIR:-/tmp}/tssh-XXXXXXXX")
SSH_OPTS=(
  -o "HostName=$IP"
  -o "ControlMaster=auto"
  -o "ControlPath=$CONTROL_PATH"
  -o "ControlPersist=10s"
)

# If we just started the VM, wait for sshd to be answering. Uses the same
# ControlPath, so the successful probe primes the multiplexed master and
# the prompt only happens once.
if [ "$STATE" != "running" ]; then
  ready=0
  for _ in $(seq 1 30); do
    if ssh "${SSH_OPTS[@]}" -o "ConnectTimeout=2" "$SSH_HOST" true </dev/null 2>/dev/null; then
      ready=1; break
    fi
    sleep 1
  done
  if [ "$ready" -ne 1 ]; then
    echo "$prog: SSH did not respond on $VM ($IP) within 30 s." >&2
    exit 1
  fi
fi

# Optional preconnect hook — runs after the VM has an IP, before the
# terminfo install and user session. Use it for per-machine setup
# (credential sync, config rsync, etc.) that shouldn't live in this
# wrapper.
PRECONNECT="${TART_PRECONNECT:-$HOME/.config/tart-stacks/preconnect}"
if [ -x "$PRECONNECT" ]; then
  TSSH_VM="$VM" TSSH_IP="$IP" TSSH_CONTROL_PATH="$CONTROL_PATH" TSSH_SSH_HOST="$SSH_HOST" \
    "$PRECONNECT" || {
      echo "$prog: preconnect hook ($PRECONNECT) exited non-zero — opening session anyway." >&2
    }
fi

# Terminfo install: piggybacks on the multiplexed connection.
LOCAL_TERM="${TERM:-xterm-256color}"
if ! ssh "${SSH_OPTS[@]}" -o "ConnectTimeout=5" "$SSH_HOST" \
    "infocmp '${LOCAL_TERM}' >/dev/null 2>&1" </dev/null 2>/dev/null; then
  if ! infocmp -x "${LOCAL_TERM}" \
      | ssh "${SSH_OPTS[@]}" "$SSH_HOST" 'mkdir -p ~/.terminfo && tic -x -' \
      >/dev/null; then
    echo "$prog: terminfo install for $LOCAL_TERM on $VM failed — session may have rendering issues" >&2
  fi
fi

exec ssh "${SSH_OPTS[@]}" "$SSH_HOST" "$@"
