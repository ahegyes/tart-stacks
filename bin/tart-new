#!/usr/bin/env bash
# tart-new — create a Tart project VM by cloning a stack base image, with the
# validation `tart clone` lacks: confirms the stack exists and its image is
# built (offering to build it), and guards against name collisions. Resource
# flags fold in the otherwise-separate `tart set` step.
#
# Usage:
#   tart-new <name> <stack> <os> [<de>] [--cpu N] [--memory MB] [--disk-size GB]
#           [--display WxH]
#
# <stack> is the short token (php, jvm) — the same one `make build STACK=…`
# takes; <os> is the OS token (fedora) — the same one `make build OS=…`
# takes; the cloned image is `<os>-<stack>`. The optional <de> (kde, …)
# selects a GUI flavor — the same token `make build … GUI=1 DE=…` takes; the
# cloned image is then `<os>-<stack>-<de>`.
set -euo pipefail

prog="${0##*/}"

# Resolve this script's real path (following symlinks) to find the repo's
# stacks/. TART_STACKS_DIR overrides for tests.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"
REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"

# Every platform's os file (shared/*/os) — tart-new clones on any platform
# whose token is listed here, not just linux. tart_os_platform (common.sh) is
# the token-side peer of tart_vm_platform: it resolves an OS token to the
# platform that owns it, both for the "is this OS supported" gate below and
# to decide whether the clone can carry a <de>.
OS_FILES="${TART_OS_FILES:-$REPO/shared/*/os}"

DESKTOPS_FILE="${TART_DESKTOPS:-$REPO/shared/linux/desktops}"
de_supported() { grep -qxF "$1" <(grep -vE '^[[:space:]]*(#|$)' "$DESKTOPS_FILE" 2>/dev/null); }

# image_for_stack <stack> <os> [<de>] — the image name (php, ubuntu →
# ubuntu-php; php, ubuntu, kde → ubuntu-php-kde).
image_for_stack() {
  printf '%s-%s%s\n' "$2" "$1" "${3:+-$3}"
}

# list_stacks — short stack tokens (php, jvm) discovered from stacks/*/.
list_stacks() {
  local d
  for d in "$STACKS_DIR"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    printf '%s\n' "${d##*/}"
  done
}

# stack_exists <stack> — 0 if stacks/<stack>/ is present.
stack_exists() {
  [ -d "$STACKS_DIR/$1" ]
}

# image_built <stack> <os> [<de>] — 0 if image_for_stack's result is a
# *local* row in `tart list` (an OCI-pulled row of the same name does not count as built).
image_built() {
  tart list --format json 2>/dev/null \
    | jq -e --arg n "$(image_for_stack "$1" "$2" "${3:-}")" \
        'any(.[]; .Name == $n and .Source == "local")' >/dev/null
}

# vm_exists <name> — 0 if any VM/image of that exact name is in `tart list`.
vm_exists() {
  tart list --format json 2>/dev/null \
    | jq -e --arg n "$1" 'any(.[]; .Name == $n)' >/dev/null
}

usage() {
  echo "usage: $prog <name> <stack> <os> [<de>] [--cpu N] [--memory MB] [--disk-size GB] [--display WxH]" >&2
}

# The screen a GUI clone is born with, absent an explicit --display.
DEFAULT_DISPLAY_GEOMETRY="1920x1080"

# need_value <flag> <value> — usage error (64) unless the flag carries a
# non-empty value. Call sites pass "${2:-}" for the space form, so a missing
# argument reports the flag instead of dying as an opaque set -u error. Empty is
# refused for a separate reason: every consumer below reads "" as "flag absent"
# and drops it, so `--cpu=` would report success for a resource it never set.
# Called as a statement: inside `CPU=$(need_value …)` the exit would leave the
# subshell, not the script, and parsing would carry on with an empty value.
need_value() {
  [ -n "$2" ] && return 0
  echo "$prog: option '$1' requires a value" >&2
  usage
  exit 64
}

tart_need_cmd tart "Install: brew install openai/tools/tart"
tart_need_cmd jq   "Install: brew install jq"

CPU="" MEM="" DISK="" DISPLAY_GEOMETRY=""
positionals=()
while [ $# -gt 0 ]; do
  case "$1" in
    --cpu)         need_value "$1" "${2:-}"; CPU="$2"; shift 2 ;;
    --memory)      need_value "$1" "${2:-}"; MEM="$2"; shift 2 ;;
    --disk-size)   need_value "$1" "${2:-}"; DISK="$2"; shift 2 ;;
    --display)     need_value "$1" "${2:-}"; DISPLAY_GEOMETRY="$2"; shift 2 ;;
    --cpu=*)       need_value "${1%%=*}" "${1#*=}"; CPU="${1#*=}"; shift ;;
    --memory=*)    need_value "${1%%=*}" "${1#*=}"; MEM="${1#*=}"; shift ;;
    --disk-size=*) need_value "${1%%=*}" "${1#*=}"; DISK="${1#*=}"; shift ;;
    --display=*)   need_value "${1%%=*}" "${1#*=}"; DISPLAY_GEOMETRY="${1#*=}"; shift ;;
    -h|--help)     usage; exit 0 ;;
    -*)            echo "$prog: unknown option '$1'" >&2; usage; exit 64 ;;
    *)             positionals+=("$1"); shift ;;
  esac
done
[ "${#positionals[@]}" -eq 3 ] || [ "${#positionals[@]}" -eq 4 ] || { usage; exit 64; }
NAME="${positionals[0]}"
STACK="${positionals[1]}"
OS="${positionals[2]}"
DE="${positionals[3]:-}"

# 1. The name must be a token every consumer can carry: it becomes the ssh
#    alias, the guest hostname (`hostname -s` must equal it — dots would
#    truncate), and a vm-pattern token (commas and `*` are grammar there).
#    Gating at create time makes every downstream assumption hold by
#    construction; raw `tart clone` stays the escape hatch for exotic names.
if ! tart_valid_vm_name "$NAME"; then
  echo "$prog: invalid VM name '$NAME' — use letters, digits, '_' or '-', starting with a letter or digit; the 'tart-' prefix is reserved for ssh aliases. (The name becomes the ssh alias tart-$NAME and the guest hostname.)" >&2
  exit 1
fi

# 1b. The base-image namespace is reserved. tart-up, tart-down and tart-rm all
#     refuse a name of this shape, so creating one mints a VM the rest of the
#     toolchain declines to start, stop or delete. It also keeps the collision
#     message below honest: a name tart-rm would refuse cannot reach it.
if tart_is_base_image "$NAME" "$STACKS_DIR" "$OS_FILES" "$DESKTOPS_FILE"; then
  echo "$prog: '$NAME' is a reserved base-image name (<os>-base, <os>-<stack>, or <os>-<stack>-<de>) — those are clone sources, not dev VMs. Pick a project name instead." >&2
  exit 1
fi

# 1c. Geometry must be WIDTHxHEIGHT. `tart set` runs after `tart clone`, so a
#     malformed value rejected there would leave a created-but-unconfigured VM
#     behind under `set -e`; catching it here costs nothing and never clones.
if [ -n "$DISPLAY_GEOMETRY" ]; then
  case "$DISPLAY_GEOMETRY" in
    *[!0-9x]*|x*|*x|*x*x*) display_ok=0 ;;
    *x*)                   display_ok=1 ;;
    *)                     display_ok=0 ;;
  esac
  if [ "$display_ok" -ne 1 ]; then
    echo "$prog: --display expects WIDTHxHEIGHT (e.g. 1920x1080), got '$DISPLAY_GEOMETRY'" >&2
    exit 64
  fi
fi

# 2. Stack must exist in the repo.
if ! stack_exists "$STACK"; then
  echo "$prog: no stack '$STACK'; available: $(list_stacks | sort | paste -sd, - | sed 's/,/, /g')" >&2
  exit 1
fi

# 3. OS must be supported, and must resolve to exactly one platform. This VM
#    doesn't exist yet, so there's nothing in `tart list` to ask — unlike
#    tart_vm_platform, tart_os_platform decides from the token and shared/*/os
#    alone. The listing below groups tokens under the platform that claims
#    them (check-os at Makefile:121-148 is the shape matched) rather than
#    flattening them: a reader can't route a flattened "macos fedora ubuntu"
#    back to a directory.
PLATFORM=$(tart_os_platform "$OS" "$OS_FILES") || {
  echo "$prog: OS '$OS' not supported; available:" >&2
  # shellcheck disable=SC2086  # deliberately unquoted: OS_FILES is a shell
  # glob (shared/*/os) expanding to one file per platform.
  for f in $OS_FILES; do
    echo "  $(basename "$(dirname "$f")"):" >&2
    grep -vE '^[[:space:]]*(#|$)' "$f" | sed 's/^/    /' >&2
  done
  exit 1
}

# 3a. darwin has no DE axis — the macOS desktop is intrinsic, so a darwin
#     image is always named <os>-<stack>, never <os>-<stack>-<de>. This must
#     precede de_supported below: an UNSUPPORTED token (e.g. cinnamon) would
#     otherwise be refused as "desktop 'cinnamon' not supported; available:
#     kde, gnome, xfce" — true nowhere, and it misdirects the reader at
#     shared/linux/desktops instead of naming the real reason. Mirrors the
#     Makefile's check-gui refusal (Makefile:163-166).
if [ -n "$DE" ] && [ "$PLATFORM" = "darwin" ]; then
  echo "$prog: <de> is a linux-only argument — the macOS desktop is intrinsic, so darwin images have no DE axis and are named <os>-<stack> with no -<de> suffix. Use 'tart-up --gui=window' (or --gui=vnc) on the clone instead." >&2
  exit 1
fi

# 3b. The GUI flavor, when asked for, must be a supported desktop token.
if [ -n "$DE" ] && ! de_supported "$DE"; then
  echo "$prog: desktop '$DE' not supported; available: $(grep -vE '^[[:space:]]*(#|$)' "$DESKTOPS_FILE" | paste -sd, - | sed 's/,/, /g')" >&2
  exit 1
fi

# Image name for this stack + OS (+ GUI flavor) — used by the not-built
# hint and the clone below.
img="$(image_for_stack "$STACK" "$OS" "$DE")"

# 4. No clobbering an existing VM. Sits ahead of the build offer so a 15-20 min
#    build can never end in "already exists".
if vm_exists "$NAME"; then
  # tart-rm, not raw `tart delete`: it stops the VM and scrubs the host-key pin
  # this script would otherwise have to work around.
  echo "$prog: VM '$NAME' already exists. Use a different name, or 'tart-rm $NAME' first." >&2
  exit 1
fi

# 5. Image must be built. Offer to build interactively; otherwise fail with the
#    exact command (no silent 15-20 min side-effect).
if ! image_built "$STACK" "$OS" "$DE"; then
  echo "$prog: stack '$STACK' image '$img' is not built." >&2
  echo "  build it with: make build STACK=$STACK OS=$OS${DE:+ GUI=1 DE=$DE}" >&2
  if [ -t 0 ] && [ -t 1 ]; then
    printf '%s: build it now? [y/N] ' "$prog" >&2
    read -r reply
    # Array, not a ${DE:+…} inline expansion: the GUI pair must reach make as
    # two separate words, and the array form says so without leaning on
    # field-splitting rules a reader has to re-derive.
    build_args=(STACK="$STACK" OS="$OS")
    [ -n "$DE" ] && build_args+=(GUI=1 DE="$DE")
    case "$reply" in
      [yY]|[yY][eE][sS]) make -C "$REPO" build "${build_args[@]}" || { echo "$prog: build failed." >&2; exit 1; } ;;
      *) exit 1 ;;
    esac
  else
    exit 1
  fi
fi

# Drop any stale known_hosts entry for this alias: a recreated VM gets a fresh
# per-VM host key (its first boot regenerates them), which would otherwise trip accept-new.
# The scrub precedes the clone — the collision gate has proven the name free, so
# any surviving pin is stale by definition, and a failure between clone and set
# can't strand it.
ssh-keygen -R "tart-$NAME" -f "$HOME/.ssh/known_hosts.tart" >/dev/null 2>&1 || true


# 6. Clone, then fold in resources if any were given.
tart clone "$img" "$NAME"
set_args=()
[ -n "$CPU" ]  && set_args+=(--cpu "$CPU")
[ -n "$MEM" ]  && set_args+=(--memory "$MEM")
[ -n "$DISK" ] && set_args+=(--disk-size "$DISK")
# A clone gets a workable screen by construction. Tart's own default is
# 1024x768, which nothing inside the guest can change — the resolution is a
# property of the virtual display, not of the desktop session — so a clone
# left at the default is stuck there for its whole life (measured: a real
# macos-php image's config.json ships 1024x768 with no displayRefit key). Any
# clone given a geometry gets --display-refit with it: on linux the guest
# follows the host window as it's resized, inert on a headless clone with no
# desktop to reflow. On darwin, `tart set --display <geom> --display-refit`
# succeeds and persists in config.json; whether the guest reflows is
# unverified — that needs a human resizing a host window, which no automated
# run does. A darwin clone has no <de> to key the default off — the macOS
# desktop is intrinsic, not optional — so it defaults on PLATFORM alone.
if [ -n "$DISPLAY_GEOMETRY" ]; then
  display="$DISPLAY_GEOMETRY"
elif [ -n "$DE" ] || [ "$PLATFORM" = "darwin" ]; then
  display="$DEFAULT_DISPLAY_GEOMETRY"
else
  display=""
fi
[ -n "$display" ] && set_args+=(--display "$display" --display-refit)
if [ "${#set_args[@]}" -gt 0 ]; then
  set_rc=0
  tart set "$NAME" "${set_args[@]}" || set_rc=$?
  if [ "$set_rc" -ne 0 ]; then
    # The collision gate proved this name was free, so the clone above is ours
    # and half-configured. Left behind, it makes the next attempt die at that
    # same gate, with nothing in that message pointing back here. `tart delete`,
    # not `tart-rm`: the VM never ran, and the alias's known_hosts pin was
    # already scrubbed before the clone.
    echo "$prog: 'tart set' failed for '$NAME' — deleting the clone it left behind." >&2
    tart delete "$NAME" \
      || echo "$prog: warning: '$NAME' is still there and half-configured — see tart's error above, then: tart delete $NAME" >&2
    exit "$set_rc"
  fi
fi

echo "$prog: created '$NAME' from $img — next: ssh tart-$NAME" >&2
