#!/usr/bin/env bash
# tart-rm — delete a Tart project VM, with the teardown `tart delete` lacks:
# resolves the bare or `tart-`-prefixed name, refuses stack base images, stops a
# running VM before the delete, and scrubs the VM's host-key pin from
# ~/.ssh/known_hosts.tart — the destroy-side mirror of tart-new's guarded create.
#
# Usage:
#   tart-rm <vm-name>
#
# No confirmation prompt: `tart delete` itself has none, and matching that
# keeps the command scriptable — the guards above are the value added.
set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

tart_need_cmd tart "Install: brew install cirruslabs/cli/tart"
tart_need_cmd jq   "Install: brew install jq"

# Repo root + stacks dir (TART_STACKS_DIR / TART_DISTROS / TART_DESKTOPS
# override for tests), used by the base-image guard below to recognize any
# built stack image (GUI flavors included).
REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"
DISTROS_FILE="${TART_DISTROS:-$REPO/shared/distros}"
DESKTOPS_FILE="${TART_DESKTOPS:-$REPO/shared/desktops}"

usage() {
  echo "usage: $prog <vm-name>" >&2
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -eq 1 ] || { usage; exit 64; }

VM="$1"

VM=$(tart_resolve_vm "$VM") || exit 1
# A nonzero tart_vm_state means the tool is broken, not that the name missed.
list_failed() {
  echo "$prog: 'tart list' failed — cannot read VM states; see the error above." >&2
  exit 1
}
STATE=$(tart_vm_state "$VM") || list_failed

# Base images (the `<distro>-base` bootstrap intermediate + every
# <distro>-<stack>[-<de>] built image) are clone-sources, not dev VMs — losing
# one costs a 15-20+ min rebuild, so removing one stays a deliberate raw-tart
# (or make) act. Refuse.
if tart_is_base_image "$VM" "$STACKS_DIR" "$DISTROS_FILE" "$DESKTOPS_FILE"; then
  echo "$prog: '$VM' is a stack base image, not a dev VM — refusing to remove it. Delete a base deliberately with 'tart delete $VM', or rebuild it with 'make rebuild STACK=<stack> DISTRO=<distro>'." >&2
  exit 1
fi

if [ "$STATE" = "running" ]; then
  if tart_vm_alive "$VM"; then
    # Unmasked on purpose: a failed stop of a LIVE VM must abort before the
    # delete.
    tart stop "$VM"
  else
    # Listed "running" with no live process is the crash-wedged state: this
    # stop only clears tart's stored state, so it is best-effort — the
    # delete below is what matters.
    tart stop "$VM" >/dev/null 2>&1 || true
  fi
fi

tart delete "$VM"

# The delete-side twin of tart-new's create-side scrub: with the pin gone, a
# future VM reusing this name re-pins fresh instead of tripping accept-new.
ssh-keygen -R "tart-$VM" -f "$HOME/.ssh/known_hosts.tart" >/dev/null 2>&1 || true

echo "$prog: removed '$VM' — VM deleted, host-key pin cleared" >&2
