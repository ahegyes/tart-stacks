#!/usr/bin/env bash
# tart-supervise — keep a Tart VM running across abrupt exits.
#
# A `tart run` process can die without warning — most visibly when Apple's
# Virtualization.framework hits an internal trap on a guest-vsock connect and
# aborts the whole process. The VM vanishes, every SSH session to it breaks at
# once, and Tart can leave the VM wedged in a "running" state that a plain
# `tart run` refuses to restart until `tart stop` clears it. This watches one VM
# and, whenever its `tart run` process is gone, clears the wedged state and
# brings it back via tart-up (which also re-provisions and waits for sshd).
#
# Liveness is the presence of the `tart run <vm>` process, NOT `tart list`
# state: a crash can leave the listed state at "running" while the process is
# dead, so polling the state alone would never notice.
#
# Run it in the foreground to supervise now:     tart-supervise <vm>
# Or install a per-VM LaunchAgent that does it:  tart-supervise --install <vm>
#
# A supervised VM is kept up: a manual `tart stop` is undone within one poll.
# To stop one for good, `--uninstall` it first.
#
# Restarts back off (BACKOFF_BASE, doubling to BACKOFF_CAP) while a VM keeps
# dying quickly, and reset once it has stayed up past HEALTHY seconds.
#
# A VM that disappears from `tart list` entirely (deleted, not crashed) ends
# supervision: after ABSENT_LIMIT consecutive confirmed-absent checks the
# supervisor removes its own LaunchAgent and exits clean.

set -uo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the PATH symlink that setup installs)
# so it can source bin/lib and bake its own real path into the LaunchAgent.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
SELF="$SCRIPT_DIR/$prog"
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

# Repo root + stacks dir (TART_STACKS_DIR / TART_DISTROS override for tests),
# used by the --install base-image guard to recognize any built stack image.
REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"
DISTROS_FILE="${TART_DISTROS:-$REPO/shared/distros}"

# Tunables (env-overridable; defaults suit a desktop host).
POLL="${TART_SUPERVISE_POLL:-5}"                 # liveness poll interval, seconds
BACKOFF_BASE="${TART_SUPERVISE_BACKOFF_BASE:-5}"
BACKOFF_CAP="${TART_SUPERVISE_BACKOFF_CAP:-60}"
HEALTHY="${TART_SUPERVISE_HEALTHY:-60}"          # uptime past which a restart counts as recovered
ABSENT_LIMIT="${TART_SUPERVISE_ABSENT_LIMIT:-3}" # confirmed-absent checks before self-removal
LAUNCHAGENTS_DIR="${TART_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"
LOG_DIR="${TART_LOG_DIR:-$HOME/Library/Logs/tart-stacks}"

log() { printf '%s %s: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$prog" "$*" >&2; }

usage() {
  cat >&2 <<EOF
usage: $prog <vm>                supervise <vm> in the foreground (loops)
       $prog --once <vm>         bring <vm> up once if it is down, then exit
       $prog --install <vm>      install + load a LaunchAgent that supervises <vm>
       $prog --uninstall <vm>    unload + remove <vm>'s LaunchAgent
       $prog --status [<vm>]     show supervised VMs and their LaunchAgent state
EOF
}

label_for() { printf 'com.tart-stacks.supervise.%s' "$1"; }

# Query Tart for one VM's state by exact name; empty output = no such VM. A
# nonzero exit means tart itself failed — callers must keep "broken tool" and
# "VM missing" distinct: --install refuses on either, but only a CONFIRMED
# miss may advance the loop's gone-VM counter.
resolve_state() {
  tart list --format json | jq -r --arg name "$1" '.[] | select(.Name==$name) | .State'
}

# ensure_up <vm> — if the VM's process is gone, clear any wedged state and start
# it. tart-up owns start + provision + readiness; this adds only the crash-state
# cleanup that restarting after an abnormal exit needs.
ensure_up() {
  local vm="$1"
  tart_vm_alive "$vm" && return 0
  log "'$vm' appears down — restarting"
  # Re-check liveness right before stopping: an interactive login may have raced
  # to start the VM in the gap, and we must not tear that down. `tart stop` on a
  # genuinely-dead VM only clears the wedged "running" state a crash leaves.
  tart_vm_alive "$vm" && return 0
  tart stop "$vm" >/dev/null 2>&1 || true
  tart-up "$vm"
}

supervise_loop() {
  local vm="$1" backoff="$BACKOFF_BASE" up_start up state absent=0 label
  label=$(label_for "$vm")
  while :; do
    ensure_up "$vm" || log "'$vm' did not come up; will retry"
    up_start=$(date +%s)
    while tart_vm_alive "$vm"; do sleep "$POLL"; done
    up=$(( $(date +%s) - up_start ))
    # Every wake funnels through here — an ensure_up failure drops out of the
    # poll above at once, a crash breaks it — so this is the one spot to ask
    # whether the VM still EXISTS, at no extra poll cost. Enough consecutive
    # confirmed-absent checks mean it was deleted: supervision has nothing
    # left to restart and would otherwise retry forever, so it removes itself.
    # A FAILING `tart list` is "cannot tell", never "absent" — the counter
    # holds, or transient tart breakage would self-destruct supervision.
    if state=$(resolve_state "$vm"); then
      if [ -n "$state" ]; then
        absent=0
      else
        absent=$((absent + 1))
        if [ "$absent" -ge "$ABSENT_LIMIT" ]; then
          log "'$vm' is gone from 'tart list' ($absent consecutive checks) — removing supervision and exiting"
          # Plist first: when running as the LaunchAgent, bootout can kill
          # this process on the spot, and the file must not outlive it. A
          # foreground run has no agent — both steps no-op harmlessly.
          rm -f "$LAUNCHAGENTS_DIR/$label.plist"
          launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
          # If bootout does not kill this process (foreground mode), the
          # clean exit plus the plist's SuccessfulExit=false keeps launchd
          # from resurrecting the agent.
          exit 0
        fi
      fi
    fi
    # A VM that stayed up past HEALTHY was stable — restart promptly (reset to
    # base). A fast failure waits the current backoff now, then escalates it for
    # next time, so a crash loop backs off instead of hammering. (Reset before
    # the sleep / escalate after it, so the first fast restart waits BACKOFF_BASE,
    # not double it.)
    [ "$up" -ge "$HEALTHY" ] && backoff="$BACKOFF_BASE"
    log "'$vm' exited after ${up}s — restarting in ${backoff}s"
    sleep "$backoff"
    if [ "$up" -lt "$HEALTHY" ]; then
      backoff=$(( backoff * 2 ))
      [ "$backoff" -gt "$BACKOFF_CAP" ] && backoff="$BACKOFF_CAP"
    fi
  done
}

render_plist() { # <vm> <self> <path-env> <logfile>
  local vm="$1" self="$2" path_env="$3" logfile="$4"
  # Aqua session: tart run needs the logged-in GUI context for vmnet + the
  # Virtualization entitlement. KeepAlive=SuccessfulExit=false restarts the
  # supervisor whenever it dies, yet honors its one deliberate clean exit (the
  # gone-VM terminal path) instead of resurrecting it; ThrottleInterval bounds
  # a respawn storm if it dies on launch. AbandonProcessGroup: launchd's
  # default on bootout is to SIGKILL the job's whole process group, which
  # includes the supervised `tart run` — uninstall means "stop supervising",
  # not "power off the VM".
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$(label_for "$vm")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$self</string>
    <string>$vm</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$path_env</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>AbandonProcessGroup</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>$logfile</string>
  <key>StandardErrorPath</key><string>$logfile</string>
</dict>
</plist>
EOF
}

install_agent() {
  local vm="$1"
  tart_need_cmd launchctl
  tart_need_cmd tart   "Install: brew install cirruslabs/cli/tart"
  tart_need_cmd tart-up "tart-up must be on PATH (run script/setup)."
  tart_need_cmd jq     "Install: brew install jq"
  # Gate before any side effect. A missing VM would install an agent that
  # retries a hopeless tart-up forever; a base image would loop just as
  # endlessly on tart-up's clone-source refusal.
  local state
  if ! state=$(resolve_state "$vm"); then
    echo "$prog: 'tart list' failed — cannot verify '$vm' exists; see the error above." >&2
    return 1
  fi
  if [ -z "$state" ]; then
    echo "$prog: VM '$vm' not found — nothing to supervise. Try 'tart list' or 'tart-new $vm <stack> <distro>'." >&2
    return 1
  fi
  if tart_is_base_image "$vm" "$STACKS_DIR" "$DISTROS_FILE"; then
    echo "$prog: '$vm' is a stack base image, not a dev VM — refusing to supervise it. Clone one with 'tart-new <name> <stack> <distro>'." >&2
    return 1
  fi
  local label plist path_env logfile tart_dir tartup_dir jq_dir
  label=$(label_for "$vm")
  plist="$LAUNCHAGENTS_DIR/$label.plist"
  tart_dir=$(dirname "$(command -v tart)")
  tartup_dir=$(dirname "$(command -v tart-up)")
  # jq rides along for the loop's gone-VM `tart list` checks — launchd's
  # default PATH has no Homebrew dir.
  jq_dir=$(dirname "$(command -v jq)")
  path_env="$tart_dir:$tartup_dir:$jq_dir:/usr/bin:/bin"
  logfile="$LOG_DIR/supervise.$vm.log"
  mkdir -p "$LAUNCHAGENTS_DIR" "$LOG_DIR"
  render_plist "$vm" "$SELF" "$path_env" "$logfile" > "$plist"
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true   # drop any prior instance first
  if launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null; then
    log "installed and loaded $label"
  else
    log "wrote $plist but 'launchctl bootstrap' failed — load it with: launchctl bootstrap gui/$(id -u) \"$plist\""
    return 1
  fi
}

uninstall_agent() {
  local vm="$1"
  tart_need_cmd launchctl
  local label plist
  label=$(label_for "$vm")
  plist="$LAUNCHAGENTS_DIR/$label.plist"
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  rm -f "$plist"
  log "removed $label — supervision only: '$vm' (if running) stays up; stop it with 'tart stop $vm', delete it with 'tart-rm $vm'"
}

status_agents() {
  local want="${1:-}"; want="${want#tart-}"
  local found=0 plist label vm agent state proc
  # One `tart list` serves every row. If it fails, the vm column degrades to
  # `?` behind one stderr note — a broken tart must not hide which agents
  # exist or whether their processes are alive.
  local list_json="" list_ok=1
  if ! list_json=$(tart list --format json 2>/dev/null); then
    list_ok=0
    echo "$prog: 'tart list' failed — VM presence unknown, shown as vm:?." >&2
  fi
  for plist in "$LAUNCHAGENTS_DIR"/com.tart-stacks.supervise.*.plist; do
    [ -e "$plist" ] || continue
    label="${plist##*/}"; label="${label%.plist}"
    vm="${label#com.tart-stacks.supervise.}"
    [ -n "$want" ] && [ "$want" != "$vm" ] && continue
    found=1
    if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
      agent="loaded"
    else
      agent="installed (not loaded)"
    fi
    # vm:MISSING (list succeeded, name absent) is the deleted-VM tell — the
    # agent on that row is supervising nothing. Distinct from vm:? (the list
    # itself failed, presence unknowable).
    state="?"
    if [ "$list_ok" -eq 1 ]; then
      state=$(jq -r --arg name "$vm" '.[] | select(.Name==$name) | .State' <<<"$list_json" 2>/dev/null) || state="?"
      [ -n "$state" ] || state="MISSING"
    fi
    if tart_vm_alive "$vm"; then proc="alive"; else proc="-"; fi
    printf '%-24s %-23s vm:%-8s proc:%s\n' "$vm" "$agent" "$state" "$proc"
  done
  if [ "$found" -ne 1 ]; then
    if [ -n "$want" ]; then
      echo "no supervised VM matching '$want'"
    else
      echo "no supervised VMs"
    fi
  fi
}

case "${1:-}" in
  -h|--help)   usage; exit 0 ;;
  --install)   [ $# -eq 2 ] || { usage; exit 64; }; install_agent   "${2#tart-}" ;;
  --uninstall) [ $# -eq 2 ] || { usage; exit 64; }; uninstall_agent "${2#tart-}" ;;
  --status)    [ $# -le 2 ] || { usage; exit 64; }; status_agents   "${2:-}" ;;
  --once)      [ $# -eq 2 ] || { usage; exit 64; }
               tart_need_cmd tart; tart_need_cmd tart-up
               ensure_up "${2#tart-}" ;;
  -*|'')       usage; exit 64 ;;
  *)           [ $# -eq 1 ] || { usage; exit 64; }
               tart_need_cmd tart; tart_need_cmd tart-up
               supervise_loop "${1#tart-}" ;;
esac
