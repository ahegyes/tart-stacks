#!/usr/bin/env bash
# tart-down — stop a Tart project VM. A thin, safe wrapper over `tart stop`: it
# accepts the SSH alias form the rest of the tooling uses, and refuses base
# images, which are clone sources rather than VMs anyone runs.
#
# Usage:
#   tart-down <vm-name>
set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"
OS_FILES="${TART_OS_FILES:-$REPO/shared/*/os}"
DESKTOPS_FILE="${TART_DESKTOPS:-$REPO/shared/linux/desktops}"

usage() { echo "usage: $prog <vm-name>" >&2; }

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -eq 1 ] || { usage; exit 64; }

tart_need_cmd tart "Install: brew install openai/tools/tart"
tart_need_cmd jq   "Install: brew install jq"

VM=$(tart_resolve_vm "$1") || exit 1

if tart_is_base_image "$VM" "$STACKS_DIR" "$OS_FILES" "$DESKTOPS_FILE"; then
  echo "$prog: '$VM' is a stack base image, not a dev VM — refusing to stop it." >&2
  exit 1
fi

# `tart stop` fails on an already-stopped VM, which is the requested end state:
# report it and succeed rather than making the caller distinguish the two.
if ! tart stop "$VM" 2>/dev/null; then
  STATE=$(tart_vm_state "$VM") || {
    echo "$prog: 'tart list' failed — cannot read VM states; see the error above." >&2
    exit 1
  }
  if [ "$STATE" = "running" ]; then
    echo "$prog: '$VM' is still running — 'tart stop' failed." >&2
    exit 1
  fi
  echo "$prog: '$VM' was already stopped." >&2
  exit 0
fi

echo "$prog: '$VM' stopped." >&2
