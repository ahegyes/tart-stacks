#!/usr/bin/env bash
# tart-up — ensure a Tart VM is running and reachable on TCP :22, starting it
# (with any configured virtiofs mounts) if it's stopped. Exits 0 once the VM
# answers on :22; does NOT open an SSH session.
#
# Invoked two ways:
#   - by the `Match host tart-* sessiontype shell exec "tart-up %n"` line that
#     tart-ssh-sync writes, so a plain `ssh tart-<name>` auto-starts the VM on
#     an interactive login (and only then — git/rsync/`ssh -N`/IDEs don't);
#   - directly, to pre-warm a VM:  tart-up <name>
#
# Readiness is a TCP probe (nc -z), never an authenticated ssh — so the SSH
# client that connects right after is the only thing that prompts for Touch ID.
# Accepts the name bare (`app-a`) or `tart-`-prefixed (`tart-app-a`), since the
# SSH alias arrives prefixed (`%n`) but Tart stores VMs bare.
#
# Directory mounts: if ~/.config/tart-stacks/mounts (override $TART_MOUNTS)
# selects this VM, the matching `--dir` virtiofs shares are added to the
# `tart run` that starts it. A `--dir` attaches at boot, so it applies only when
# tart-up STARTS the VM — see dir_args_for_vm.

set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

if [ $# -ne 1 ]; then
  echo "Usage: $prog <vm-name>" >&2
  exit 64
fi

VM="$1"

need_cmd tart "Install: brew install cirruslabs/cli/tart"
need_cmd jq   "Install: brew install jq"
need_cmd nc   "Install netcat, or use the macOS built-in at /usr/bin/nc."

# Query Tart for one VM's state by exact name; empty output = no such VM.
resolve_state() {
  tart list --format json 2>/dev/null \
    | jq -r --arg name "$1" '.[] | select(.Name==$name) | .State'
}

# Two-way prefix lookup: the SSH alias is `tart-<name>` (so `%n` arrives
# prefixed), but Tart stores VMs bare. Try the name as-given, then swap the
# prefix on a miss so either form works. Empty after both = genuinely absent.
STATE=$(resolve_state "$VM")
if [ -z "$STATE" ]; then
  case "$VM" in
    tart-*) ALT="${VM#tart-}" ;;
    *)      ALT="tart-$VM" ;;
  esac
  STATE=$(resolve_state "$ALT")
  if [ -z "$STATE" ]; then
    echo "$prog: VM '$VM' not found (also tried '$ALT'). Try 'tart list' or 'tart-new $VM <stack>'." >&2
    exit 1
  fi
  VM="$ALT"
fi

# Refuse stack clone-sources (base images) — they aren't dev VMs. A `tart-*`
# wildcard SSH config matches them too, so fail fast rather than boot one.
if [[ "${VM#tart-}" =~ ^(fedora-base|fedora-[a-z]+)$ ]]; then
  echo "$prog: '$VM' is a stack base image, not a dev VM — refusing to start. Clone one with 'tart-new <name> <stack>'." >&2
  exit 1
fi

# ---- net-policy (opt-in; applies uniformly to every VM) --------------------
# Whitespace-separated tart `--net-*` flags read from a single file; tokens
# emitted as one CLI arg per line. Comment/blank tolerant (# and empty lines).
# Empty/absent file = no args (default Tart NAT, unfiltered). Engine writes
# this file (workbench: ~/.config/tart-stacks/netpolicy with softnet @host-only
# confinement); tart-stacks just consumes it. Applies at `tart run` start —
# running VMs need stop+start to pick up changes.
NETPOLICY_CONFIG=$(tart_config_path netpolicy)

netpolicy_args() {
  [ -f "$NETPOLICY_CONFIG" ] || return 0
  local raw line tok
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    for tok in $line; do printf '%s\n' "$tok"; done
  done < "$NETPOLICY_CONFIG"
}

# ---- per-VM directory mounts (opt-in) --------------------------------------
MOUNTS_CONFIG=$(tart_config_path mounts)

# tart_pattern_matches <pattern> <bare-vm> — 0 if the vm-pattern selects this VM.
#   pattern: `*` (any) | <vm> | <a>,<b>,... (comma list, no spaces).
tart_pattern_matches() {
  local pattern="$1" vm="$2"
  [ "$pattern" = "*" ] && return 0
  local -a names=()
  IFS=',' read -r -a names <<< "$pattern"
  local n
  for n in "${names[@]}"; do
    [ "$n" = "$vm" ] && return 0
  done
  return 1
}

# dir_args_for_vm <bare-vm> — print one `--dir=<name>:<path>[:ro]` per mounts
# line selecting this VM. Line format: `<vm-pattern> [<name>=]<host-path>[:ro]`;
# the in-VM share name is <name> when given (mounts at /mnt/shared/<name>), else
# the path's basename. Give an explicit name when two mounts would otherwise
# collide on basename (e.g. ~/Source/.../workbench vs ~/.config/workbench).
dir_args_for_vm() {
  local vm="$1"
  [ -f "$MOUNTS_CONFIG" ] || return 0
  local raw line pattern rest path ro name
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    if [ -z "$rest" ]; then
      echo "${prog:-tart-up}: $MOUNTS_CONFIG: no path on line, skipping: $raw" >&2
      continue
    fi
    tart_pattern_matches "$pattern" "$vm" || continue
    case "$rest" in
      *:ro) ro=":ro"; path="${rest%:ro}" ;;
      *)    ro="";    path="$rest" ;;
    esac
    # Optional explicit share name: `name=/abs/path`. Falls back to the path
    # basename — give a name when two mounts would otherwise collide on basename.
    case "$path" in
      /*)   name="$(basename "$path")" ;;
      *=/*) name="${path%%=*}"; path="${path#*=}" ;;
      *)    echo "${prog:-tart-up}: $MOUNTS_CONFIG: malformed mount (need [<name>=]<absolute-path>), skipping: $raw" >&2; continue ;;
    esac
    printf -- '--dir=%s:%s%s\n' "$name" "$path" "$ro"
  done < "$MOUNTS_CONFIG"
  return 0
}

# Resolve this VM's net-policy + mounts once (bare name for mounts; netpolicy
# is VM-agnostic). Both reused by the start + warning paths.
NET_ARGS=()
while IFS= read -r n; do
  [ -n "$n" ] && NET_ARGS+=("$n")
done < <(netpolicy_args)

DIR_ARGS=()
while IFS= read -r d; do
  [ -n "$d" ] && DIR_ARGS+=("$d")
done < <(dir_args_for_vm "${VM#tart-}")

if [ "$STATE" = "running" ]; then
  if [ "${#DIR_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — ${#DIR_ARGS[@]} configured mount(s) not attached (stop + start to apply)." >&2
  fi
  if [ "${#NET_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — net-policy from $NETPOLICY_CONFIG not applied (stop + start to apply)." >&2
  fi
elif [ "$STATE" = "stopped" ]; then
  echo "$prog: VM '$VM' is $STATE — starting in background..." >&2
  # Build the command as one array so the empty-args case is safe under
  # `set -u` on bash 3.2 (the macOS system bash). Net flags before dir flags:
  # tart's --net-* family is mutually exclusive, so keep them visually adjacent.
  run_cmd=(tart run "$VM" --no-graphics)
  [ "${#NET_ARGS[@]}" -gt 0 ] && run_cmd+=("${NET_ARGS[@]}")
  [ "${#DIR_ARGS[@]}" -gt 0 ] && run_cmd+=("${DIR_ARGS[@]}")
  ( "${run_cmd[@]}" >/dev/null 2>&1 & disown )
else
  # Any other state (e.g. another invocation already started it) — don't issue
  # a second `tart run`; just let the poll below converge. Race-tolerant.
  echo "$prog: VM '$VM' is $STATE — waiting for it to come up..." >&2
fi

# Poll for a DHCP-assigned IP (Tart's NAT usually assigns within ~5-15 s).
IP=""
for _ in $(seq 1 60); do
  IP=$(tart ip "$VM" 2>/dev/null) && [ -n "$IP" ] && break
  IP=""
  sleep 1
done
if [ -z "$IP" ]; then
  echo "$prog: VM '$VM' did not get an IP within 60 s." >&2
  exit 1
fi

# Wait for sshd to accept TCP on :22 — a port probe only, NO authentication.
# (An authenticated `ssh ... true` here would be a second Touch-ID prompt; the
# SSH client's own ProxyCommand does the authenticated connect right after.)
for _ in $(seq 1 30); do
  if nc -z "$IP" 22 >/dev/null 2>&1; then
    # Set the guest hostname to the VM name. Tart does NOT do this (VMs boot as
    # the base-image default), yet consumers key on it: the per-VM MCP-broker
    # token lookup (`hostname -s`) and the zsh "which-VM" prompt. Use the guest
    # agent (`tart exec`, over vsock) — NOT ssh — so it never triggers Touch ID.
    # Idempotent + best-effort: an older guest agent / missing hostnamectl no-ops.
    if [ "$(tart exec "$VM" hostname -s 2>/dev/null)" != "$VM" ]; then
      tart exec "$VM" sudo hostnamectl set-hostname "$VM" >/dev/null 2>&1 || true
    fi
    # Per-VM host keys: clones share the base's baked-in key, so regenerate once
    # (marker-gated, over vsock — no Touch ID). Stage to .new then swap so sshd is
    # never keyless; restart is synchronous, so :22 is back when tart exec returns.
    # shellcheck disable=SC2016  # $t/${t} are for the GUEST shell — keep single-quoted
    regen='test -e /etc/ssh/.tart-keys && exit 0; cd /etc/ssh || exit 1; for t in rsa ecdsa ed25519; do ssh-keygen -q -N "" -t "$t" -f "ssh_host_${t}_key.new" || exit 1; done; for t in rsa ecdsa ed25519; do mv -f "ssh_host_${t}_key.new" "ssh_host_${t}_key"; mv -f "ssh_host_${t}_key.new.pub" "ssh_host_${t}_key.pub"; done; touch .tart-keys && systemctl restart sshd'
    tart exec "$VM" sudo sh -c "$regen" >/dev/null 2>&1 || true
    exit 0
  fi
  sleep 1
done
echo "$prog: $VM ($IP) did not accept SSH on :22 within 30 s." >&2
exit 1
