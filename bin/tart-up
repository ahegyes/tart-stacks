#!/usr/bin/env bash
# tart-up — ensure a Tart VM is running and reachable on TCP :22, starting it
# (with any configured virtiofs mounts) if it's stopped. Exits 0 once the VM
# answers on :22; does NOT open an SSH session.
#
# Invoked two ways:
#   - by the `Match host tart-* sessiontype shell exec "tart-up %n"` line that
#     tart-ssh-sync writes, so a plain `ssh tart-<name>` auto-starts the VM on
#     an interactive login (and only then — git/rsync/`ssh -N`/IDEs don't);
#   - directly, to pre-warm a VM:  tart-up <name>
#
# Readiness is a TCP probe (nc -z), never an authenticated ssh — so the SSH
# client that connects right after is the only thing that prompts for Touch ID.
# Accepts the name bare (`app-a`) or `tart-`-prefixed (`tart-app-a`), since the
# SSH alias arrives prefixed (`%n`) but Tart stores VMs bare.
#
# Directory mounts: if ~/.config/tart-stacks/mounts (override $TART_MOUNTS)
# selects this VM, the matching `--dir` virtiofs shares are added to the
# `tart run` that starts it. A `--dir` attaches at boot, so it applies only when
# tart-up STARTS the VM — see dir_args.

set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

# Repo root + stacks dir (TART_STACKS_DIR overrides for tests), used by the
# base-image guard below to recognize any built stack image regardless of OS.
REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"
DISTROS_FILE="${TART_DISTROS:-$REPO/shared/distros}"

usage() {
  echo "usage: $prog <vm-name>" >&2
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -eq 1 ] || { usage; exit 64; }

VM="$1"

tart_need_cmd tart "Install: brew install cirruslabs/cli/tart"
tart_need_cmd jq   "Install: brew install jq"
tart_need_cmd nc   "Install netcat, or use the macOS built-in at /usr/bin/nc."

# Query Tart for one VM's state by exact name; empty output = no such VM.
resolve_state() {
  tart list --format json 2>/dev/null \
    | jq -r --arg name "$1" '.[] | select(.Name==$name) | .State'
}

# Two-way prefix lookup: the SSH alias is `tart-<name>` (so `%n` arrives
# prefixed), but Tart stores VMs bare. Try the name as-given, then swap the
# prefix on a miss so either form works. Empty after both = genuinely absent.
STATE=$(resolve_state "$VM")
if [ -z "$STATE" ]; then
  case "$VM" in
    tart-*) ALT="${VM#tart-}" ;;
    *)      ALT="tart-$VM" ;;
  esac
  STATE=$(resolve_state "$ALT")
  if [ -z "$STATE" ]; then
    echo "$prog: VM '$VM' not found (also tried '$ALT'). Try 'tart list' or 'tart-new $VM <stack>'." >&2
    exit 1
  fi
  VM="$ALT"
fi

# Base images (the `<distro>-base` bootstrap intermediate + every <distro>-<stack>
# built image) are clone-sources, not dev VMs — but the `tart-*` SSH wildcard
# matches them too. Refuse.
if tart_is_base_image "${VM#tart-}" "$STACKS_DIR" "$DISTROS_FILE"; then
  echo "$prog: '$VM' is a stack base image, not a dev VM — refusing to start. Clone one with 'tart-new <name> <stack> <distro>'." >&2
  exit 1
fi

# ---- net-policy (opt-in; applies uniformly to every VM) --------------------
# Whitespace-separated tart `--net-*` flags read from a single file; tokens
# emitted as one CLI arg per line. Comment/blank tolerant (# and empty lines).
# Empty/absent file = no args (default Tart NAT, unfiltered). An external
# producer writes this file; tart-stacks only consumes it (e.g. a softnet
# @host-only egress confinement). Applies at `tart run` start — running VMs
# need stop+start to pick up changes.
NETPOLICY_CONFIG=$(tart_config_path netpolicy)

netpolicy_args() {
  [ -f "$NETPOLICY_CONFIG" ] || return 0
  local raw line tok
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    for tok in $line; do printf '%s\n' "$tok"; done
  done < "$NETPOLICY_CONFIG"
}

# ---- per-VM directory mounts (opt-in) --------------------------------------
MOUNTS_CONFIG=$(tart_config_path mounts)

# dir_args <bare-vm> — print one `--dir=<name>:<path>[:ro]` per mounts
# line selecting this VM. Line format: `<vm-pattern> [<name>=]<host-path>[:ro]`;
# the in-VM share name is <name> when given (mounts at /mnt/shared/<name>), else
# the path's basename. Give an explicit name when two mounts would otherwise
# collide on basename (e.g. ~/src/app vs ~/.config/app).
dir_args() {
  local vm="$1"
  [ -f "$MOUNTS_CONFIG" ] || return 0
  local raw line pattern rest path ro name
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    if [ -z "$rest" ]; then
      echo "${prog:-tart-up}: $MOUNTS_CONFIG: no path on line, skipping: $raw" >&2
      continue
    fi
    tart_pattern_matches "$pattern" "$vm" || continue
    case "$rest" in
      *:ro) ro=":ro"; path="${rest%:ro}" ;;
      *)    ro="";    path="$rest" ;;
    esac
    # Optional explicit share name: `name=/abs/path`. Falls back to the path
    # basename — give a name when two mounts would otherwise collide on basename.
    name=""
    case "$path" in
      *=/*) name="${path%%=*}"; path="${path#*=}" ;;
    esac
    case "$path" in
      /*) [ -n "$name" ] || name="$(basename "$path")" ;;
      *)  echo "${prog:-tart-up}: $MOUNTS_CONFIG: malformed mount (need [<name>=]<absolute-path>), skipping: $raw" >&2; continue ;;
    esac
    printf -- '--dir=%s:%s%s\n' "$name" "$path" "$ro"
  done < "$MOUNTS_CONFIG"
  return 0
}

# Resolve this VM's net-policy + mounts once (bare name for mounts; netpolicy
# is VM-agnostic). Both reused by the start + warning paths.
NETPOLICY_ARGS=()
while IFS= read -r n; do
  [ -n "$n" ] && NETPOLICY_ARGS+=("$n")
done < <(netpolicy_args)

DIR_ARGS=()
while IFS= read -r d; do
  [ -n "$d" ] && DIR_ARGS+=("$d")
done < <(dir_args "${VM#tart-}")

# Guest-agent provisioning (hostname + host-key regen, below) runs only on a
# boot this script starts: it is once-per-boot work, and each `tart exec` opens
# a guest-vsock connection, which can trip an Apple Virtualization.framework trap
# that aborts the whole VM. An already-running VM was provisioned on the boot
# that started it, so re-probing it every login is waste and risk. (A clone's
# first boot goes through tart-up in the normal flow — tart-new leaves it
# stopped; the first ssh/tart-up starts it. A clone first-started by a bare
# `tart run` would miss host-key regen until its next tart-up-driven start.)
STARTED=0

if [ "$STATE" = "running" ]; then
  if [ "${#DIR_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — its ${#DIR_ARGS[@]} configured mount(s) attach at boot, so it has whatever it started with (stop + start to apply mount changes)." >&2
  fi
  if [ "${#NETPOLICY_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — net-policy (from $NETPOLICY_CONFIG) applies at boot, so it has whatever it started with (stop + start to apply net-policy changes)." >&2
  fi
elif [ "$STATE" = "stopped" ]; then
  echo "$prog: VM '$VM' is $STATE — starting in background..." >&2
  # Build the command as one array so the empty-args case is safe under
  # `set -u` on bash 3.2 (the macOS system bash). Net flags before dir flags:
  # tart's --net-* family is mutually exclusive, so keep them visually adjacent.
  run_cmd=(tart run "$VM" --no-graphics)
  [ "${#NETPOLICY_ARGS[@]}" -gt 0 ] && run_cmd+=("${NETPOLICY_ARGS[@]}")
  [ "${#DIR_ARGS[@]}" -gt 0 ] && run_cmd+=("${DIR_ARGS[@]}")
  # Capture tart's stderr (stdout is just VM console noise). A Tart crash is an
  # Apple Virtualization.framework trap that prints a `fixme:` line here right
  # before aborting — the only place that message survives. Truncate per boot so
  # the log always reflects the current instance (and after a crash names the
  # exact unhandled vsock case). Dir overridable via TART_LOG_DIR (tests sandbox it).
  run_log_dir="${TART_LOG_DIR:-$HOME/Library/Logs/tart-stacks}"
  mkdir -p "$run_log_dir" 2>/dev/null
  run_log="$run_log_dir/${VM}.run.log"
  # Logging must never be why a VM fails to start (this is the only start path):
  # probe the actual target — if the dir or the file itself can't be opened for
  # writing, drop stderr rather than let the redirect fail the launch.
  : >>"$run_log" 2>/dev/null || run_log="/dev/null"
  ( "${run_cmd[@]}" >/dev/null 2>"$run_log" & disown )
  STARTED=1
else
  # Any other state (e.g. another invocation already started it) — don't issue
  # a second `tart run`; just let the poll below converge. Race-tolerant.
  echo "$prog: VM '$VM' is $STATE — waiting for it to come up..." >&2
fi

# Poll for a DHCP-assigned IP (Tart's NAT usually assigns within ~5-15 s).
IP=""
for _ in $(seq 1 60); do
  IP=$(tart ip "$VM" 2>/dev/null) && [ -n "$IP" ] && break
  IP=""
  sleep 1
done
if [ -z "$IP" ]; then
  echo "$prog: VM '$VM' did not get an IP within 60 s." >&2
  exit 1
fi

# Wait for sshd to accept TCP on :22 — a port probe only, NO authentication.
# (An authenticated `ssh ... true` here would be a second Touch-ID prompt; the
# SSH client's own ProxyCommand does the authenticated connect right after.)
# Re-resolve the IP each iteration and bound the probe (-G 3): the first
# `tart ip` answer can be a stale lease (e.g. left from a prior softnet/bridged
# config) that is unreachable — an unbounded `nc -z` would block on it forever,
# wedging the interactive ssh that gates on this exec. A bounded probe plus
# re-resolve lets the address self-correct once DHCP settles on the live one.
for _ in $(seq 1 30); do
  cur=$(tart ip "$VM" 2>/dev/null) && [ -n "$cur" ] && IP="$cur"
  if nc -z -G 3 "$IP" 22 >/dev/null 2>&1; then
    if [ "$STARTED" -ne 1 ]; then
      exit 0  # already-running VM: provisioned on its own boot; skip vsock calls
    fi
    # Set the guest hostname to the VM name. Tart does NOT do this (VMs boot as
    # the base-image default), yet consumers key on it: a downstream `hostname -s`
    # lookup and the zsh "which-VM" prompt. Use the guest
    # agent (`tart exec`, over vsock) — NOT ssh — so it never triggers Touch ID.
    # Idempotent + best-effort: an older guest agent / missing hostnamectl no-ops.
    if [ "$(tart exec "$VM" hostname -s 2>/dev/null)" != "$VM" ]; then
      tart exec "$VM" sudo hostnamectl set-hostname "$VM" >/dev/null 2>&1 || true
      # Re-check: a silent miss (old guest agent / no hostnamectl) leaves the base
      # default, and hostname-keyed lookups in downstream tooling (via
      # `hostname -s`) then resolve wrong — painful to trace back here. Warn if so.
      [ "$(tart exec "$VM" hostname -s 2>/dev/null)" = "$VM" ] || \
        echo "$prog: warning: could not set guest hostname to '$VM' — hostname-keyed lookups in downstream tooling may resolve wrong." >&2
    fi
    # Per-VM host keys: clones share the base's baked-in key, so regenerate once
    # (marker-gated, over vsock — no Touch ID). Stage to .new then swap so sshd is
    # never keyless; restart is synchronous, so :22 is back when tart exec returns.
    # shellcheck disable=SC2016  # $t/${t} are for the GUEST shell — keep single-quoted
    regen='test -e /etc/ssh/.tart-keys && exit 0; cd /etc/ssh || exit 1; for t in rsa ecdsa ed25519; do ssh-keygen -q -N "" -t "$t" -f "ssh_host_${t}_key.new" || exit 1; done; for t in rsa ecdsa ed25519; do mv -f "ssh_host_${t}_key.new" "ssh_host_${t}_key"; mv -f "ssh_host_${t}_key.new.pub" "ssh_host_${t}_key.pub"; done; touch .tart-keys && systemctl restart sshd'
    tart exec "$VM" sudo sh -c "$regen" >/dev/null 2>&1 || true
    exit 0
  fi
  sleep 1
done
echo "$prog: $VM ($IP) did not accept SSH on :22 in time." >&2
exit 1
