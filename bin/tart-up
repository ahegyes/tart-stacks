#!/usr/bin/env bash
# tart-up — ensure a Tart VM is running and reachable on TCP :22, starting it
# (with any configured virtiofs mounts) if it's stopped. Exits 0 once the VM
# answers on :22; does NOT open an SSH session.
#
# Invoked two ways:
#   - by the `Match host tart-* sessiontype shell exec "/bin/sh -c '…' _ '<tart-up>' %n"`
#     line that tart-ssh-sync writes (gated on a controlling terminal), so a
#     plain `ssh tart-<name>` from a terminal auto-starts the VM on an
#     interactive login (and only then — git/rsync/`ssh -N`/IDE scans don't);
#   - directly, to pre-warm a VM:  tart-up <name>
#
# Readiness is a TCP probe (nc -z, via /usr/bin/nc — override $TART_NC_BIN),
# never an authenticated ssh — so the SSH client that connects right after is
# the only thing that prompts for Touch ID.
# Accepts the name bare (`app-a`) or `tart-`-prefixed (`tart-app-a`), since the
# SSH alias arrives prefixed (`%n`) but Tart stores VMs bare.
#
# Directory mounts: if ~/.config/tart-stacks/mounts (override $TART_MOUNTS)
# selects this VM, the matching `--dir` virtiofs shares are added to the
# `tart run` that starts it. A `--dir` attaches at boot, so it applies only when
# tart-up STARTS the VM — see dir_args.
# GUI mode: `--gui=` overrides an exact-name entry in
# ~/.config/tart-stacks/gui (override $TART_GUI); absent means headless. On a
# LINUX window boot, the guest desktop is scaled to the main host display's
# backing scale before its session starts (override $TART_DISPLAY_SCALE) — a
# macOS guest's own window needs no such step. VNC differs by platform too:
# linux serves it from a guest-side systemd unit; darwin has no guest listener
# at all, serving it host-side via Tart's own `--vnc-experimental`. Platform is
# read from Tart itself (`tart get --format json`'s OS field), never guessed
# from the image name — see tart_vm_platform in bin/lib/common.sh, which
# refuses to answer rather than default to linux on a failed read.

set -euo pipefail

prog="${0##*/}"

# Resolve this script's real dir (following the ~/.local/bin symlink that
# script/setup installs) to source the shared bin/lib helpers.
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

# Repo root + stacks dir (TART_STACKS_DIR overrides for tests), used by the
# base-image guard below to recognize any built stack image regardless of OS
# or platform.
REPO=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
STACKS_DIR="${TART_STACKS_DIR:-$REPO/stacks}"
OS_FILES="${TART_OS_FILES:-$REPO/shared/*/os}"
DESKTOPS_FILE="${TART_DESKTOPS:-$REPO/shared/linux/desktops}"

# BSD nc's -G is the probe's connect bound; a PATH-shadowing GNU netcat parses
# -G as a no-op, so pin the system binary (TART_NC_BIN is the test seam).
NC_BIN="${TART_NC_BIN:-/usr/bin/nc}"

usage() {
  cat >&2 <<EOF
usage: $prog [--gui=headless|vnc|window] <vm-name>

GUI mode is a boot property. The command-line flag overrides an exact bare-name
entry in ~/.config/tart-stacks/gui (override TART_GUI):
  <bare-vm-name> headless|vnc|window
An absent entry defaults to headless. Corrupt or duplicate entries fail closed.

Window mode opens Tart's VM window. Closing that window kills the VM, and a
windowed launch needs a GUI login session; a daemon context may not be able to
open the window. On a LINUX guest, tart-up applies the main host display's
integer backing scale (native pixels / logical points) before starting that
boot's desktop session; a macOS guest's own window needs no such step, since
it is up as soon as the VM is.
Set TART_DISPLAY_SCALE to force a scale: non-integers warn and use 1, and values
outside 1-3 are clamped into that range with a warning.
Detection failures use 1, and guest application failures warn but continue.

VNC mode differs by platform: a LINUX guest serves it from a guest-side
systemd unit on 127.0.0.1:5901 (tunnel with ssh -L). A darwin guest has no
guest-side VNC listener at all — Tart's own --vnc-experimental serves it from
the HOST, on an ephemeral per-boot port; point a VNC client straight at the
vnc:// URL tart-up prints once it has verified that port is live.
EOF
}

GUI_OVERRIDE=""
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --gui=headless|--gui=vnc|--gui=window)
    GUI_OVERRIDE="${1#--gui=}"
    shift ;;
  --gui*) usage; exit 64 ;;
esac
[ $# -eq 1 ] || { usage; exit 64; }

VM="$1"

tart_need_cmd tart "Install: brew install openai/tools/tart"
tart_need_cmd jq   "Install: brew install jq"
# Preflight the pinned probe binary: a missing one would otherwise surface as
# 30 silent probe failures and a misleading ":22 timeout" diagnosis.
[ -x "$NC_BIN" ] || { echo "$prog: SSH probe binary '$NC_BIN' not found or not executable." >&2; exit 1; }

VM=$(tart_resolve_vm "$VM" " Or create it: tart-new ${VM#tart-} <stack> <os>.") || exit 1
# A nonzero tart_vm_state means the tool is broken, not that the name missed.
list_failed() {
  echo "$prog: 'tart list' failed — cannot read VM states; see the error above." >&2
  exit 1
}
STATE=$(tart_vm_state "$VM") || list_failed

# Base images (the `<os>-base` bootstrap intermediate + every
# <os>-<stack>[-<de>] built image) are clone-sources, not dev VMs — but
# the `tart-*` SSH wildcard matches them too. Refuse.
if tart_is_base_image "$VM" "$STACKS_DIR" "$OS_FILES" "$DESKTOPS_FILE"; then
  echo "$prog: '$VM' is a stack base image, not a dev VM — refusing to start. Clone one with 'tart-new <name> <stack> <os>'." >&2
  exit 1
fi

# ---- net-policy (opt-in; applies uniformly to every VM) --------------------
# Whitespace-separated tart `--net-*` flags read from a single file; tokens
# emitted as one CLI arg per line. Comment/blank tolerant (# and empty lines).
# Empty/absent file = no args (default Tart NAT, unfiltered). An external
# producer writes this file; tart-stacks only consumes it (e.g. a softnet
# @host-only egress confinement). Applies at `tart run` start — running VMs
# need stop+start to pick up changes.
NETPOLICY_CONFIG=$(tart_config_path netpolicy)

# Emit policy tokens one per line; nonzero on any token that is not a --net-*
# flag. This is security config, so it fails closed: a stray token means a
# corrupt (or tampered-with) file, and starting the VM with only PART of the
# policy applied is worse than not starting it at all.
netpolicy_args() {
  [ -f "$NETPOLICY_CONFIG" ] || return 0
  local raw line lineno=0 tok
  local -a toks=()
  while IFS= read -r raw || [ -n "$raw" ]; do
    lineno=$((lineno + 1))
    line="${raw%%#*}"
    # read -ra splits on whitespace without pathname expansion — an unquoted
    # `for tok in $line` would glob each token against the current directory.
    IFS=$' \t' read -ra toks <<< "$line"
    [ "${#toks[@]}" -gt 0 ] || continue
    for tok in "${toks[@]}"; do
      case "$tok" in
        --net-*) printf '%s\n' "$tok" ;;
        *)
          echo "${prog:-tart-up}: $NETPOLICY_CONFIG line $lineno: '$tok' is not a --net-* flag — refusing to start with a partial net-policy. (A flag's value must ride the = form: --net-bridged=en0, not --net-bridged en0.)" >&2
          return 1 ;;
      esac
    done
  done < "$NETPOLICY_CONFIG"
}

# ---- per-VM directory mounts (opt-in) --------------------------------------
MOUNTS_CONFIG=$(tart_config_path mounts)

# dir_args <bare-vm> — print one `--dir=<name>:<path>[:ro]` per mounts
# line selecting this VM. Line format: `<vm-pattern> [<name>=]<host-path>[:ro]`;
# the in-VM share name is <name> when given (mounts at /mnt/shared/<name>), else
# the path's basename. Give an explicit name when two mounts would otherwise
# collide on basename (e.g. ~/src/app vs ~/.config/app).
dir_args() {
  local vm="$1"
  [ -f "$MOUNTS_CONFIG" ] || return 0
  # An unreadable file would otherwise drop every share silently, and a VM
  # missing its mounts is indistinguishable from one that has them until
  # something reads an empty /mnt/shared. The caller decides what to do with the
  # refusal: only a boot can be started without its shares.
  if [ ! -r "$MOUNTS_CONFIG" ]; then
    echo "${prog:-tart-up}: $MOUNTS_CONFIG: file exists but is not readable, so this VM's shares cannot be resolved. Fix it with: chmod 600 $MOUNTS_CONFIG" >&2
    return 1
  fi
  local raw line pattern rest path ro name pattern_ok pat_n
  local -a pat_names=()
  while IFS= read -r raw || [ -n "$raw" ]; do
    line="${raw%%#*}"
    IFS=$' \t' read -r pattern rest <<< "$line"
    [ -z "$pattern" ] && continue
    if [ -z "$rest" ]; then
      echo "${prog:-tart-up}: $MOUNTS_CONFIG: no path on line, skipping: $raw" >&2
      continue
    fi
    # The grammar is `*` | <name> | <a>,<b>,… — validated rather than just matched,
    # because an unsupported form like `app-*` matches nothing and would otherwise
    # drop the share silently. A VM that starts without its mount looks identical
    # to one that has it until something writes to /mnt/shared and loses it with
    # the clone. Same check tart-ssh-sync applies to the forwards file.
    if [ "$pattern" != "*" ]; then
      pattern_ok=1
      IFS=',' read -r -a pat_names <<< "$pattern"
      [ "${#pat_names[@]}" -gt 0 ] || pattern_ok=0
      for pat_n in "${pat_names[@]}"; do
        tart_valid_vm_name "$pat_n" || { pattern_ok=0; break; }
      done
      if [ "$pattern_ok" -ne 1 ]; then
        echo "${prog:-tart-up}: $MOUNTS_CONFIG: selector '$pattern' is not '*', a bare VM name, or a comma list of them — this mount is NOT attached: $raw" >&2
        continue
      fi
    fi
    tart_pattern_matches "$pattern" "$vm" || continue
    case "$rest" in
      *:ro) ro=":ro"; path="${rest%:ro}" ;;
      *)    ro="";    path="$rest" ;;
    esac
    # Optional explicit share name: `name=/abs/path`. Falls back to the path
    # basename — give a name when two mounts would otherwise collide on basename.
    name=""
    case "$path" in
      *=/*) name="${path%%=*}"; path="${path#*=}" ;;
    esac
    case "$path" in
      /*) [ -n "$name" ] || name="$(basename "$path")" ;;
      *)  echo "${prog:-tart-up}: $MOUNTS_CONFIG: malformed mount (need [<name>=]<absolute-path>), skipping: $raw" >&2; continue ;;
    esac
    printf -- '--dir=%s:%s%s\n' "$name" "$path" "$ro"
  done < "$MOUNTS_CONFIG"
  return 0
}

# ---- per-VM gui mode (opt-in) ----------------------------------------------
GUI_CONFIG=$(tart_config_path gui)

# This is boot config, so it fails closed: starting the VM with only PART of a
# corrupt file applied is worse than not starting it at all.
gui_config_error() {
  local location=""
  [ -n "$1" ] && location=" line $1"
  echo "${prog:-tart-up}: $GUI_CONFIG$location: $2 — refusing to start; starting the VM with only PART of the gui config applied is worse than not starting it at all." >&2
}

# gui_file_mode <bare-vm> — validate the entire exact-name file, then print
# this VM's mode (headless when absent). Unlike mounts/forwards, this plane has
# one winner per VM: patterns and duplicate names are corrupt config.
gui_file_mode() {
  local vm="$1" raw line lineno=0 name mode seen selected=""
  local -a fields=() seen_names=()
  [ -f "$GUI_CONFIG" ] || { printf 'headless'; return 0; }
  if [ ! -r "$GUI_CONFIG" ]; then
    gui_config_error "" "file exists but is not readable"
    return 1
  fi

  while IFS= read -r raw || [ -n "$raw" ]; do
    lineno=$((lineno + 1))
    line="${raw%%#*}"
    fields=()
    IFS=$' \t' read -ra fields <<< "$line"
    [ "${#fields[@]}" -gt 0 ] || continue
    if [ "${#fields[@]}" -ne 2 ]; then
      gui_config_error "$lineno" "expected exactly '<bare-vm-name> headless|vnc|window'"
      return 1
    fi
    name="${fields[0]}"
    mode="${fields[1]}"
    if ! tart_valid_vm_name "$name"; then
      gui_config_error "$lineno" "'$name' is not an exact bare VM name (patterns and tart- prefixes are not allowed)"
      return 1
    fi
    case "$mode" in
      headless|vnc|window) ;;
      *)
        gui_config_error "$lineno" "unknown gui mode '$mode' (expected headless, vnc, or window)"
        return 1 ;;
    esac
    if [ "${#seen_names[@]}" -gt 0 ]; then
      for seen in "${seen_names[@]}"; do
        if [ "$seen" = "$name" ]; then
          gui_config_error "$lineno" "duplicate entry for VM '$name'"
          return 1
        fi
      done
    fi
    seen_names+=("$name")
    [ "$name" = "$vm" ] && selected="$mode"
  done < "$GUI_CONFIG"

  printf '%s' "${selected:-headless}"
}

# normalize_display_scale <value> — validate a non-negative decimal integer,
# clamp it to the supported 1..3 range, and print the result. Strings with a
# fractional or otherwise non-integer form fail validation so display probing
# can fall safely back to scale 1.
normalize_display_scale() {
  local value="$1"
  case "$value" in
    ''|*[!0-9]*) return 1 ;;
  esac
  # Avoid bash arithmetic here: an arbitrarily long override could overflow,
  # and a leading zero would be parsed as octal by arithmetic expansion.
  while [ "${value#0}" != "$value" ]; do
    value="${value#0}"
  done
  case "${value:-0}" in
    0)     printf '1' ;;
    1|2|3) printf '%s' "$value" ;;
    *)     printf '3' ;;
  esac
}

# main_display_scale — print the main macOS display's backing scale as an
# integer. system_profiler reports native pixels separately from the logical
# point resolution, and their quotient is the backing scale; the Retina flag is
# null even on Retina panels, so it is not a usable signal. The quotient is
# rounded because a fractional ("More Space") display mode divides the panel's
# pixels by a logical width that is not a clean half of them, while macOS still
# backs that mode with a factor of 2 — the nearest integer is the truth there,
# and an exactly-1 non-Retina panel is unaffected. This is cosmetic boot state,
# so every missing-tool, query, parse, or validation failure returns 1 and never
# prevents a VM start.
main_display_scale() {
  local raw scale stripped
  if [ "${TART_DISPLAY_SCALE+x}" = x ]; then
    raw="$TART_DISPLAY_SCALE"
    if scale=$(normalize_display_scale "$raw"); then
      # An override states intent, so silently substituting a different number
      # is the one place quiet is wrong here — the probe path clamps without
      # comment because no intent is involved. Compare against the zero-stripped
      # form so a padded "02" is not reported as out of range.
      stripped="$raw"
      while [ "${stripped#0}" != "$stripped" ]; do stripped="${stripped#0}"; done
      [ "$scale" = "${stripped:-0}" ] || [ "$scale" = "$raw" ] || \
        echo "${prog:-tart-up}: warning: TART_DISPLAY_SCALE '$raw' is outside the supported 1-3 range; using $scale." >&2
      printf '%s' "$scale"
    else
      echo "${prog:-tart-up}: warning: invalid TART_DISPLAY_SCALE '$raw' (expected an integer); using 1." >&2
      printf '1'
    fi
    return 0
  fi

  if ! command -v system_profiler >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    printf '1'
    return 0
  fi
  if ! raw=$(system_profiler -json SPDisplaysDataType 2>/dev/null | jq -r '
    [ .SPDisplaysDataType[].spdisplays_ndrvs // [] ] | add // []
    | map(select(.spdisplays_main == "spdisplays_yes"))
    | .[0] // empty
    | (._spdisplays_pixels // "") as $px
    | (._spdisplays_resolution // "") as $pt
    | ($px | split(" x ")[0] // "") as $pw
    | ($pt | split(" x ")[0] // "") as $tw
    | if ($pw|test("^[0-9]+$")) and ($tw|test("^[0-9]+$")) and (($tw|tonumber) > 0)
      then (($pw|tonumber) / ($tw|tonumber) | round) else 1 end
  ' 2>/dev/null); then
    printf '1'
    return 0
  fi
  if scale=$(normalize_display_scale "$raw"); then
    printf '%s' "$scale"
  else
    printf '1'
  fi
}

# Classify the live VNC listener rather than trusting the unit config:
# SecurityTypes=None makes this loopback bind the security boundary. Callers
# use VNC_VERIFY_STATE rather than parsing diagnostics so unsafe/read failures
# stop the poll immediately while an absent listener gets its startup grace.
vnc_listener_state() {
  local table local_addr found_v4=0
  VNC_VERIFY_STATE="read-failure"
  VNC_VERIFY_ERROR=""
  # The sudo retry is not redundant: ss lives in /usr/sbin on some guests, off
  # the login PATH but on sudo's secure_path.
  if ! table=$(tart exec "$VM" ss -tln 2>/dev/null); then
    if ! table=$(tart exec "$VM" sudo ss -tln 2>/dev/null); then
      VNC_VERIFY_ERROR="could not read the guest TCP listener table with ss"
      return 0
    fi
  fi
  while IFS=$' \t' read -r _ _ _ local_addr _; do
    case "$local_addr" in
      *:5901)
        case "$local_addr" in
          # `ok` requires the IPv4 loopback listener specifically: the contract
          # (and the tunnel command this script advertises) targets
          # 127.0.0.1:5901, so a [::1]-only bind is not yet usable — treat it
          # as absent and let the poll's grace window cover a v6-before-v4
          # bind order.
          127.0.0.1:5901) found_v4=1 ;;
          '[::1]:5901') ;;
          *)
            VNC_VERIFY_STATE="unsafe"
            VNC_VERIFY_ERROR="listener '$local_addr' is not loopback-only"
            return 0 ;;
        esac ;;
    esac
  done <<< "$table"
  if [ "$found_v4" -eq 1 ]; then
    VNC_VERIFY_STATE="ok"
  else
    VNC_VERIFY_STATE="absent"
  fi
  return 0
}

vnc_wait_for_loopback() {
  local attempt
  for ((attempt = 1; attempt <= 30; attempt++)); do
    vnc_listener_state
    case "$VNC_VERIFY_STATE" in
      ok) return 0 ;;
      absent) sleep 1 ;;
      unsafe|read-failure) return 1 ;;
    esac
  done
  VNC_VERIFY_ERROR="timed out after 30 seconds waiting for the 127.0.0.1:5901 listener"
  return 1
}

# Any failed verification must remove the unauthenticated service. A failed
# guest-agent stop leaves the listener's safety unknown, so power off the VM;
# preserving availability is not worth preserving a possibly exposed VNC.
vnc_fail_closed() {
  if tart exec "$VM" sudo systemctl stop tart-stacks-vnc.service >/dev/null 2>&1; then
    echo "$prog: '$VM' vnc gui activation failed loopback-bind verification: $VNC_VERIFY_ERROR; stopped tart-stacks-vnc.service because SecurityTypes=None requires a loopback-only listener." >&2
  elif tart stop "$VM" >/dev/null 2>&1; then
    echo "$prog: '$VM' vnc gui activation failed loopback-bind verification: $VNC_VERIFY_ERROR; stopping tart-stacks-vnc.service failed, so stopped VM '$VM' to prevent a possibly exposed SecurityTypes=None listener." >&2
  else
    echo "$prog: '$VM' vnc gui activation failed loopback-bind verification: $VNC_VERIFY_ERROR; FAILED to stop tart-stacks-vnc.service and FAILED to stop VM '$VM' — an unauthenticated non-loopback VNC listener may still be running." >&2
  fi
}

# ---- darwin-only boot steps -------------------------------------------------
# macOS has no hostnamectl; scutil is the guest-side equivalent. All three
# names are set because different consumers read a different one: `hostname
# -s` follows LocalHostName, ComputerName is what the UI shows, and HostName
# is what a DNS/mDNS resolver would return — setting only one leaves a clone
# half-renamed in a way that surfaces only when the missed consumer is read.
darwin_set_hostname() {
  tart exec "$1" sudo scutil --set HostName      "$1" >/dev/null 2>&1 || return 1
  tart exec "$1" sudo scutil --set LocalHostName "$1" >/dev/null 2>&1 || return 1
  tart exec "$1" sudo scutil --set ComputerName  "$1" >/dev/null 2>&1 || return 1
}

DARWIN_VNC_URL="" DARWIN_VNC_HOST="" DARWIN_VNC_PORT=""

# darwin_vnc_wait_for_url — poll this boot's run log for the "VNC server is
# running at vnc://..." line --vnc-experimental prints once Virtualization.
# Framework's VNC server has bound its (ephemeral, per-boot) port. There is no
# guest-side signal to probe instead: unlike the linux image's systemd unit,
# this surface never reaches the guest at all.
darwin_vnc_wait_for_url() {
  local attempt line
  for ((attempt = 1; attempt <= 30; attempt++)); do
    if [ -n "$run_log" ] && line=$(grep -m1 '^VNC server is running at ' "$run_log" 2>/dev/null); then
      DARWIN_VNC_URL="${line#VNC server is running at }"
      return 0
    fi
    sleep 1
  done
  return 1
}

# darwin_vnc_parse_url <url> — split Tart's `vnc://:<password>@<host>:<port>`
# into DARWIN_VNC_HOST/DARWIN_VNC_PORT. The port is ephemeral per boot (unlike
# the linux image's fixed guest-side 5901), so it is only ever knowable by
# reading what Tart itself printed.
darwin_vnc_parse_url() {
  local url="$1" rest
  case "$url" in
    vnc://*@*:*) ;;
    *) return 1 ;;
  esac
  rest="${url#vnc://}"
  rest="${rest#*@}"
  DARWIN_VNC_HOST="${rest%:*}"
  DARWIN_VNC_PORT="${rest##*:}"
  case "$DARWIN_VNC_PORT" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ -n "$DARWIN_VNC_HOST" ]
}

# darwin_vnc_wait_for_listener — verify the HOST port Tart printed actually
# accepts a connection before reporting success: the same fail-closed shape
# the linux vnc path applies via vnc_wait_for_loopback (probe rather than
# trust the advertised state), but on a HOST port instead of a guest one, and
# reachability only — unlike vnc_listener_state, this never inspects the bind
# address, so it trusts DARWIN_VNC_HOST rather than classifying it. Safe today
# because Tart hardcodes the VNC listener to 127.0.0.1. Tart's own print can
# race ahead of the framework's server actually being ready to accept a
# connection.
darwin_vnc_wait_for_listener() {
  local attempt
  for ((attempt = 1; attempt <= 30; attempt++)); do
    "$NC_BIN" -z -G 3 "$DARWIN_VNC_HOST" "$DARWIN_VNC_PORT" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# Resolve this VM's net-policy + mounts + gui once (bare name for the per-VM
# planes; netpolicy is VM-agnostic). Reuse them in the start + warning paths.
# Net-policy is captured via command substitution so a bad token aborts right
# here (set -e on the assignment, after netpolicy_args printed its error) —
# read from a process substitution, the function's failure would be swallowed
# and the VM would start under a partial policy.
NETPOLICY_ARGS=()
np_tokens=$(netpolicy_args)
# <<< on an empty string still supplies one line — without the -n guard an
# empty "" arg would land in the tart run argv.
if [ -n "$np_tokens" ]; then
  while IFS= read -r n; do
    NETPOLICY_ARGS+=("$n")
  done <<< "$np_tokens"
fi

DIR_ARGS=()
# Captured the same way as the net-policy above, and for the same reason: read
# from a process substitution, dir_args' refusal would be discarded and the VM
# would start with none of its shares. The refusal is fatal only where it can
# still change the outcome — a `--dir` attaches at boot, so on a VM that is
# already up an unresolvable mounts file cannot alter what is mounted, and
# refusing there would block a login over a file that no longer decides anything.
dir_tokens=""
if ! dir_tokens=$(dir_args "$VM"); then
  if [ "$STATE" = "stopped" ]; then
    echo "$prog: refusing to start '$VM' without the shares it is configured for." >&2
    exit 1
  fi
  echo "$prog: '$VM' is already $STATE, so its mounts are whatever that boot attached — continuing." >&2
fi
if [ -n "$dir_tokens" ]; then
  while IFS= read -r d; do
    DIR_ARGS+=("$d")
  done <<< "$dir_tokens"
fi

GUI_FILE_MODE=$(gui_file_mode "$VM")
GUI_MODE="${GUI_OVERRIDE:-$GUI_FILE_MODE}"

# Guest-agent provisioning (the hostname, below) runs only on a boot this script
# starts: it is once-per-boot work, and each `tart exec` opens a guest-vsock
# connection, which can trip an Apple Virtualization.framework trap that aborts
# the whole VM. An already-running VM was provisioned on the boot that started
# it, so re-probing it every login is waste and risk.
STARTED=0
# Set by the start path below. Empty everywhere else: the log is truncated per
# `tart run`, so on a VM this invocation did not start it describes another boot.
run_log=""

if [ "$STATE" = "running" ]; then
  # A Tart crash can leave the listed state wedged at "running" with no live
  # `tart run` process — polling :22 against that ghost burns the full timeout
  # and ends in a misleading SSH-timeout error. Fail fast with the remedy
  # instead. No auto-stop here: the process scan can misread a VM launched by
  # a nonstandard `tart run` invocation, so stopping is the operator's call.
  if ! tart_vm_alive "$VM"; then
    echo "$prog: '$VM' is listed as running, but no 'tart run $VM' process exists — likely crashed or wedged (or started by a nonstandard 'tart run' invocation)." >&2
    echo "$prog: run 'tart stop $VM' then retry ssh." >&2
    exit 1
  fi
  if [ "${#DIR_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — its ${#DIR_ARGS[@]} configured mount(s) attach at boot, so it has whatever it started with (stop + start to apply mount changes)." >&2
  fi
  if [ "${#NETPOLICY_ARGS[@]}" -gt 0 ]; then
    echo "$prog: '$VM' already running — net-policy (from $NETPOLICY_CONFIG) applies at boot, so it has whatever it started with (stop + start to apply net-policy changes)." >&2
  fi
  if [ "$GUI_MODE" != "headless" ]; then
    echo "$prog: '$VM' already running — gui mode '$GUI_MODE' applies at boot, so it has whatever it started with (stop + start to apply gui mode changes)." >&2
  fi
elif [ "$STATE" = "stopped" ]; then
  # Branch on what Tart reports about this VM, never the `<os>-<stack>`
  # naming convention this repo's own images follow. Resolved only here, not
  # unconditionally up front: this is the only branch that ever reads
  # $PLATFORM (an already-running VM's hostname/gui were set on the boot that
  # started it), and it must fail closed rather than default to linux —
  # tart_vm_platform refuses to answer on a failed `tart get` or an
  # empty/unrecognized OS field (a real TOCTOU here: tart_vm_state above
  # already confirmed this VM exists, via a SEPARATE `tart list` call, and it
  # can still vanish or become briefly unreadable before this one runs).
  PLATFORM=$(tart_vm_platform "$VM") || {
    echo "$prog: could not determine whether '$VM' is a darwin or linux VM (a failed 'tart get', or an empty/unrecognized OS field — see any error above); refusing to start without knowing which platform-specific boot steps it needs." >&2
    exit 1
  }
  echo "$prog: VM '$VM' is $STATE — starting in background..." >&2
  # Build the command as one array so the empty-args case is safe under
  # `set -u` on bash 3.2 (the macOS system bash). Net flags before dir flags:
  # tart's --net-* family is mutually exclusive, so keep them visually adjacent.
  run_cmd=(tart run "$VM")
  if [ "$GUI_MODE" != "window" ]; then
    run_cmd+=(--no-graphics)
    # darwin's vnc surface is Tart's OWN host-side VNC server
    # (Virtualization.Framework), added only here — unlike linux's guest-side
    # systemd unit, it opens no listener inside the guest at all.
    [ "$PLATFORM" = "darwin" ] && [ "$GUI_MODE" = "vnc" ] && run_cmd+=(--vnc-experimental)
  fi
  [ "${#NETPOLICY_ARGS[@]}" -gt 0 ] && run_cmd+=("${NETPOLICY_ARGS[@]}")
  [ "${#DIR_ARGS[@]}" -gt 0 ] && run_cmd+=("${DIR_ARGS[@]}")
  # Capture tart's stderr (stdout is just VM console noise). A Tart crash is an
  # Apple Virtualization.framework trap that prints a `fixme:` line here right
  # before aborting — the only place that message survives. Truncate per boot so
  # the log always reflects the current instance (and after a crash names the
  # exact unhandled vsock case). Dir overridable via TART_LOG_DIR (tests sandbox it).
  run_log_dir="${TART_LOG_DIR:-$HOME/Library/Logs/tart-stacks}"
  mkdir -p "$run_log_dir" 2>/dev/null || true
  run_log="$run_log_dir/${VM}.run.log"
  # Logging must never be why a VM fails to start (this is the only start path):
  # probe the actual target — if the dir or the file itself can't be opened for
  # writing, drop stderr rather than let the redirect fail the launch. Clearing
  # run_log is what stops the timeout diagnostics below pointing at a log that
  # captured nothing.
  : >>"$run_log" 2>/dev/null || run_log=""
  if [ "$PLATFORM" = "darwin" ] && [ "$GUI_MODE" = "vnc" ]; then
    # --vnc-experimental's "VNC server is running at ..." line is Tart's own
    # stdout, not stderr — the only mode that needs it merged into the per-VM
    # log the darwin vnc verify below reads back.
    ( "${run_cmd[@]}" >"${run_log:-/dev/null}" 2>&1 & disown )
  else
    ( "${run_cmd[@]}" >/dev/null 2>"${run_log:-/dev/null}" & disown )
  fi
  STARTED=1
else
  # Any other state (e.g. another invocation already started it) — don't issue
  # a second `tart run`; just let the poll below converge. Race-tolerant.
  echo "$prog: VM '$VM' is $STATE — waiting for it to come up..." >&2
fi

# Poll for a DHCP-assigned IP (Tart's NAT usually assigns within ~5-15 s).
IP=""
for _ in $(seq 1 60); do
  IP=$(tart ip "$VM" 2>/dev/null) && [ -n "$IP" ] && break
  IP=""
  sleep 1
done
if [ -z "$IP" ]; then
  echo "$prog: VM '$VM' did not get an IP within 60 s." >&2
  # The launch is detached, so a `tart run` that failed outright looks exactly
  # like a slow DHCP lease from here — its real error is only in the log.
  [ -n "$run_log" ] && echo "$prog: if it never started, tart's own error for this boot is in $run_log." >&2
  exit 1
fi

# Wait for sshd to accept TCP on :22 — a port probe only, NO authentication.
# (An authenticated `ssh ... true` here would be a second Touch-ID prompt; the
# SSH client's own ProxyCommand does the authenticated connect right after.)
# Re-resolve the IP each iteration and bound the probe (-G 3): the first
# `tart ip` answer can be a stale lease (e.g. left from a prior softnet/bridged
# config) that is unreachable — an unbounded `nc -z` would block on it forever,
# wedging the interactive ssh that gates on this exec. A bounded probe plus
# re-resolve lets the address self-correct once DHCP settles on the live one.
for _ in $(seq 1 30); do
  cur=$(tart ip "$VM" 2>/dev/null) && [ -n "$cur" ] && IP="$cur"
  if "$NC_BIN" -z -G 3 "$IP" 22 >/dev/null 2>&1; then
    if [ "$STARTED" -ne 1 ]; then
      exit 0  # already-running VM: provisioned on its own boot; skip vsock calls
    fi
    # Set the guest hostname to the VM name. Tart does NOT do this (VMs boot as
    # the base-image default), yet consumers key on it: a downstream `hostname -s`
    # lookup and the zsh "which-VM" prompt. Use the guest
    # agent (`tart exec`, over vsock) — NOT ssh — so it never triggers Touch ID.
    # Idempotent + best-effort: an older guest agent / missing hostnamectl (linux)
    # or a failed scutil call (darwin — see darwin_set_hostname) no-ops.
    if [ "$(tart exec "$VM" hostname -s 2>/dev/null)" != "$VM" ]; then
      if [ "$PLATFORM" = "darwin" ]; then
        darwin_set_hostname "$VM" || true
      else
        tart exec "$VM" sudo hostnamectl set-hostname "$VM" >/dev/null 2>&1 || true
      fi
      # Re-check: a silent miss (old guest agent / no hostnamectl on linux, a
      # failed scutil call on darwin) leaves the base default, and
      # hostname-keyed lookups in downstream tooling (via `hostname -s`) then
      # resolve wrong — painful to trace back here. Warn if so.
      [ "$(tart exec "$VM" hostname -s 2>/dev/null)" = "$VM" ] || \
        echo "$prog: warning: could not set guest hostname to '$VM' — hostname-keyed lookups in downstream tooling may resolve wrong." >&2
    fi
    case "$GUI_MODE" in
      window)
        if [ "$PLATFORM" = "darwin" ]; then
          : # A macOS guest's window IS its desktop session — up as soon as
            # the VM is, with no display manager to isolate into and no host
            # backing-scale mismatch to correct (Tart renders it natively).
        else
          # Tart refits a native window's framebuffer in host device pixels, so
          # apply that window's host backing scale before the display manager
          # creates the first session. VNC deliberately has no equivalent: it has
          # no host window whose backing scale the guest inherits.
          display_scale=$(main_display_scale)
          # `2>&1 >/dev/null` captures stderr only: the guest names WHICH step
          # failed — wrong user, unsupported DE, missing python3 or dbus, an
          # unparseable XFCE settings file — and that reason is the whole
          # diagnosis of a symptom ("my desktop is the wrong size") that looks
          # identical from here whatever caused it.
          if ! scale_err=$(tart exec "$VM" /usr/local/bin/tart-stacks-display-scale "$display_scale" 2>&1 >/dev/null); then
            echo "$prog: warning: could not apply display scale '$display_scale' in '$VM'; continuing with window gui activation." >&2
            [ -n "$scale_err" ] && printf '  %s\n' "$scale_err" >&2
          fi
          if ! tart exec "$VM" sudo systemctl isolate graphical.target >/dev/null; then
            echo "$prog: '$VM' window gui activation failed: 'systemctl isolate graphical.target' did not succeed; the VM remains running and headless-usable." >&2
            exit 1
          fi
          # Isolating graphical.target only Wants= the display manager, so the
          # isolate succeeds even on an image with no DM baked (or a DM that
          # fails). The desktop is the point of window mode — verify the DM
          # actually comes up before reporting success.
          dm_active=""
          for _ in $(seq 1 15); do
            if tart exec "$VM" systemctl is-active --quiet display-manager.service 2>/dev/null; then
              dm_active=1
              break
            fi
            sleep 1
          done
          if [ -z "$dm_active" ]; then
            echo "$prog: '$VM' window gui activation failed: display-manager.service did not become active after isolating graphical.target (is a desktop baked into this image? see /etc/tart-stacks-release); the VM remains running and headless-usable." >&2
            exit 1
          fi
        fi ;;
      vnc)
        if [ "$PLATFORM" = "darwin" ]; then
          if ! darwin_vnc_wait_for_url; then
            echo "$prog: '$VM' vnc gui activation failed: Tart never printed a VNC URL to this boot's log within 30 s; the VM remains running and reachable over ssh." >&2
            exit 1
          fi
          if ! darwin_vnc_parse_url "$DARWIN_VNC_URL"; then
            echo "$prog: '$VM' vnc gui activation failed: could not parse Tart's VNC URL ('$DARWIN_VNC_URL'); the VM remains running and reachable over ssh." >&2
            exit 1
          fi
          if ! darwin_vnc_wait_for_listener; then
            echo "$prog: '$VM' vnc gui activation failed: no listener came up on $DARWIN_VNC_HOST:$DARWIN_VNC_PORT within 30 s; the VM remains running and reachable over ssh." >&2
            exit 1
          fi
          echo "$prog: VNC ready for '$VM'. Point a VNC client at $DARWIN_VNC_URL" >&2
        else
          if ! tart exec "$VM" sudo systemctl start tart-stacks-vnc.service >/dev/null; then
            echo "$prog: '$VM' vnc gui activation failed: 'systemctl start tart-stacks-vnc.service' did not succeed; the VM remains running and headless-usable." >&2
            exit 1
          fi
          if ! vnc_wait_for_loopback; then
            vnc_fail_closed
            exit 1
          fi
          echo "$prog: VNC ready for '$VM'. Tunnel with: ssh -L 5901:127.0.0.1:5901 tart-$VM ; then point a VNC client at localhost:5901." >&2
        fi ;;
    esac
    exit 0
  fi
  sleep 1
done
echo "$prog: $VM ($IP) did not accept SSH on :22 in time." >&2
[ -n "$run_log" ] && echo "$prog: if it never started, tart's own error for this boot is in $run_log." >&2
exit 1
