# ~/.zshrc — tart-stacks baseline. Edits affect future VM clones; for
# an existing project VM, edit ~/.zshrc inside that VM directly.

# mise activation — per-directory tool version switching.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# fzf: Ctrl-R fuzzy history search, ** tab completion for paths.
[ -f /usr/share/fzf/shell/key-bindings.zsh ] && source /usr/share/fzf/shell/key-bindings.zsh
[ -f /usr/share/fzf/shell/completion.zsh ]   && source /usr/share/fzf/shell/completion.zsh

# Host SSH agent. tart-ssh-sync forwards it via OpenSSH ForwardAgent, so sshd
# already exports SSH_AUTH_SOCK in every session — this block is just a fallback
# for the older fixed-path pattern (a manual RemoteForward of the host agent to
# /home/admin/.ssh/forwarded-agent.sock in your Mac-side ~/.ssh/config).
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$HOME/.ssh/forwarded-agent.sock" ]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/forwarded-agent.sock"
fi

# Tool defaults. $EDITOR is read by git commit / crontab -e / visudo;
# $LESS flags: -F quit-if-one-screen, -R raw colors, -X no terminal reset on quit.
export EDITOR=${EDITOR:-nano}
export PAGER=${PAGER:-less}
export LESS=${LESS:--FRX}

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

# Minimal prompt — VM hostname makes which-VM-am-I-in obvious at a glance.
PROMPT='%F{cyan}%n@%m%f:%F{yellow}%~%f$ '

alias ll='ls -lah'
alias gs='git status -sb'

# bat/fd install as batcat/fdfind on Debian/Ubuntu — alias to the familiar
# names there (no-op where bat/fd already exist, e.g. Fedora). Interactive only.
command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1 && alias bat='batcat'
command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1 && alias fd='fdfind'

# Attach to or create a named zellij session. No args = list existing.
# Each host terminal tab/session can attach to a different session for
# parallel work (e.g., `za term` in one tab, `za docker` in another) —
# independent state per session, all survive ssh disconnect.
za() {
  if [[ $# -eq 0 ]]; then
    zellij list-sessions 2>/dev/null || echo "no zellij sessions"
  else
    zellij attach --create "$1"
  fi
}
