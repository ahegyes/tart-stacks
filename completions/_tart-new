#compdef tart-new
#
# Zsh completion for tart-new. Positional 1 is the new VM name (no completion);
# positional 2 is the stack token, completed from stacks/*/ in the repo this
# command is symlinked from (real path via `:A`); positional 3 is the distro
# token, completed from shared/linux/os; optional positional 4 is the GUI
# desktop token, completed from shared/linux/desktops. _arguments tracks positions
# net of options, so the tokens still complete when resource flags come first
# (e.g. `tart-new --cpu 4 myvm <TAB>`), and the flags complete too.
#
# Install:
#   fpath=(/path/to/tart-stacks/completions $fpath)   # before compinit
#   autoload -Uz compinit && compinit

_tart-new() {
  local curcontext="$curcontext" state line
  local -a stacks
  local bin repo

  _arguments -C \
    '--cpu[CPU cores]:cores' \
    '--memory[memory in MB]:MB' \
    '--disk-size[disk size in GB]:GB' \
    '--display[virtual display geometry, WIDTHxHEIGHT]:WxH' \
    '(-h --help)'{-h,--help}'[show usage and exit]' \
    '1:new VM name:' \
    '2:stack:->stack' \
    '3:distro:->distro' \
    '4::desktop (GUI flavor):->de'

  [[ $state == stack || $state == distro || $state == de ]] || return 0

  bin=${commands[tart-new]}
  [[ -n $bin ]] || { _message 'tart-new not on PATH'; return 1; }
  repo=${bin:A:h:h}

  [[ $state == stack ]] && {
    stacks=(${repo}/stacks/*(/N:t))
    (( ${#stacks} )) || { _message 'no stacks found under stacks/*/'; return 1; }
    _describe -t stacks 'stack' stacks; return 0
  }

  [[ $state == distro ]] && {
    local -a distros
    distros=(${(f)"$(grep -vE '^[[:space:]]*(#|$)' "${repo}/shared/linux/os" 2>/dev/null)"})
    _describe -t distros 'distro' distros; return 0
  }

  [[ $state == de ]] && {
    local -a desktops
    desktops=(${(f)"$(grep -vE '^[[:space:]]*(#|$)' "${repo}/shared/linux/desktops" 2>/dev/null)"})
    _describe -t desktops 'desktop (GUI flavor)' desktops; return 0
  }
}

_tart-new "$@"
