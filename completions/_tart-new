#compdef tart-new
#
# Zsh completion for tart-new. Positional 1 is the new VM name (no completion);
# positional 2 is the stack token, completed from stacks/fedora-*/ in the repo
# this command is symlinked from (real path via `:A`). _arguments tracks
# positions net of options, so the stack still completes when resource flags
# come first (e.g. `tart-new --cpu 4 myvm <TAB>`), and the flags complete too.
#
# Install:
#   fpath=(/path/to/tart-stacks/completions $fpath)   # before compinit
#   autoload -Uz compinit && compinit

_tart-new() {
  local curcontext="$curcontext" state line
  local -a stacks
  local bin repo

  _arguments -C \
    '--cpu[CPU cores]:cores' \
    '--memory[memory in MB]:MB' \
    '--disk-size[disk size in GB]:GB' \
    '(-h --help)'{-h,--help}'[show usage and exit]' \
    '1:new VM name:' \
    '2:stack:->stack'

  [[ $state == stack ]] || return 0

  bin=${commands[tart-new]}
  [[ -n $bin ]] || { _message 'tart-new not on PATH'; return 1; }
  repo=${bin:A:h:h}
  stacks=(${repo}/stacks/fedora-*(/N:t))
  stacks=(${stacks#fedora-})
  (( ${#stacks} )) || { _message 'no stacks found under stacks/fedora-*/'; return 1; }
  _describe -t stacks 'stack' stacks
}

_tart-new "$@"
