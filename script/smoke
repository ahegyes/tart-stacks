#!/usr/bin/env bash
# smoke — end-to-end proof of a BUILT stack image: clone a throwaway VM, boot it,
# ssh in, then attest that the image IS the cell that was asked for, and destroy
# it. One passing run exercises the whole chain — tart-new's gates, clone, boot,
# DHCP, sshd, key auth, the tart-guest-agent vsock channel `tart exec` rides on,
# tart-up's hostname provisioning, the provenance manifest, the guest's own
# os-release (sw_vers on darwin), the stack's toolchain over a NON-interactive
# ssh (the shape a script or agent uses), and sshd's effective hardening — none
# of which `packer validate` or the mocked tests can reach. The OS token
# resolves to a platform via tart_os_platform (bin/lib/common.sh) before
# anything clones, since several stages below key off it: the hostname-failure
# wording, the guest self-ID command, and the closing surface check (VNC on
# linux; a runtime listener-surface + Screen Sharing check on darwin, which has
# no guest-side VNC to probe at all). Needs the <os>-<stack> image already
# built and the host tools wired (`make setup`); boots a real VM (~1 min). Run
# via `make smoke STACK=<stack> OS=<os>` — local-only, never in CI.
#
# SMOKE_KEEP=1 skips the teardown, leaving the VM up for debugging.
set -euo pipefail

prog="${0##*/}"

REPO=$(cd -P "$(dirname "$0")/.." >/dev/null 2>&1 && pwd)

# shellcheck source=bin/lib/common.sh
. "$REPO/bin/lib/common.sh"

# Helper-resolution seam: test/smoke.sh points TART_SMOKE_BIN at a directory
# of mocks; real runs resolve the repo's bin/. `ssh` and `tart` stay plain PATH
# lookups (PATH-shimmable the same way) — the tart-<vm> alias ssh dials only
# exists in the user's generated SSH config anyway, and a missing `tart` fails
# in tart-new's own preflight before any stage here runs.
SMOKE_BIN="${TART_SMOKE_BIN:-$REPO/bin}"

usage() {
  echo "usage: $prog <stack> <os> [<de>]" >&2
  echo "  <de>          smoke the GUI flavor <os>-<stack>-<de> instead" >&2
  echo "  SMOKE_KEEP=1  keep the VM on exit (debugging — also survives a Ctrl-C)" >&2
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -eq 2 ] || [ $# -eq 3 ] || { usage; exit 64; }
STACK="$1"
OS="$2"
DE="${3:-}"

# Every platform's os file (shared/*/os), the same glob tart-new and tart-up
# read. tart_os_platform is the token-side peer of tart_vm_platform: this VM
# doesn't exist yet, so there is nothing in `tart get` to ask — the OS token
# and shared/*/os alone decide which platform's stages below apply. A
# nonzero return is refused rather than defaulted to "linux": the same
# fail-closed contract tart_os_platform's own header documents, so an
# unsupported or ambiguous token never smoke-tests the wrong platform's
# assertions.
OS_FILES="${TART_OS_FILES:-$REPO/shared/*/os}"
PLATFORM=$(tart_os_platform "$OS" "$OS_FILES") || {
  echo "$prog: OS '$OS' is not claimed by exactly one platform in shared/*/os (unsupported, or listed by more than one) — refusing to smoke-test without knowing which platform's assertions apply." >&2
  exit 1
}

# darwin has no DE axis — the macOS desktop is intrinsic, so a darwin image is
# always <os>-<stack>, never <os>-<stack>-<de>. tart-new (Task 16) refuses a
# darwin <de> too; catching it here as well means the failure reads as "smoke
# does not take this argument" instead of surfacing as tart-new's own
# downstream refusal a moment later.
if [ -n "$DE" ] && [ "$PLATFORM" = "darwin" ]; then
  echo "$prog: <de> is a linux-only argument — the macOS desktop is intrinsic, so darwin images have no DE axis. Smoke '$STACK' '$OS' with no third argument." >&2
  exit 1
fi

# Fixed name, short and obviously disposable; the SSH alias is tart-smoke-vm.
VM="smoke-vm"

# stdin from /dev/null keeps tart-new's interactive build offer out of play: a
# smoke test asserts the image is ALREADY built — it must never side-effect a
# 15-20 min `make build`. Runs before the trap below is armed: on a name
# collision the existing VM is not ours, so teardown must not touch it.
"$SMOKE_BIN/tart-new" "$VM" "$STACK" "$OS" ${DE:+"$DE"} < /dev/null

# From here the VM is ours — tear it down on ANY exit, so a failed boot or
# assert can't strand it. SMOKE_KEEP=1 keeps it for debugging instead. The
# trap re-exits with the script's own status so a teardown hiccup can't mask
# (or fabricate) a verdict.
cleanup() {
  rc=$?
  if [ "${SMOKE_KEEP:-}" = "1" ]; then
    echo "$prog: SMOKE_KEEP=1 — keeping '$VM' (remove later with: tart-rm $VM)" >&2
  else
    "$SMOKE_BIN/tart-rm" "$VM" || echo "$prog: warning: teardown failed — remove '$VM' by hand: tart-rm $VM" >&2
  fi
  exit "$rc"
}
trap cleanup EXIT

"$SMOKE_BIN/tart-up" "$VM"

# `tart exec` is a host->guest vsock call served by tart-guest-agent inside the
# guest — a different channel from the ssh every other check here uses, and one
# nothing in this repo installs: it is inherited from the base image. tart-up
# drives the guest hostname on every cell, plus all GUI activation, through it,
# so an image whose agent is absent still answers ssh while its clones keep the
# base image's hostname and `tart-up --gui` hard-fails. These run before the
# hostname assert below because a wrong hostname is their downstream symptom,
# and reporting the symptom sends the reader after the wrong thing entirely.
#
# The checks are ordered by dependency — the channel, then escalation over it,
# then whether tart-up's provisioning landed — so each failure is narrowed to the
# causes below it rather than surfacing as one undifferentiated symptom.
#
# `true` is the channel probe on purpose: tart exec propagates the GUEST
# command's own exit status, so probing with anything that can itself fail would
# report that command's failure as a dead channel.
if ! chan_err=$(tart exec "$VM" true 2>&1); then
  echo "$prog: FAIL — 'tart exec' does not answer in '$VM': ${chan_err:-no output}. That is tart-guest-agent's vsock channel, not ssh, so the fix is in the base image rather than in this build. ssh is a separate channel and may still work — try 'ssh tart-$VM systemctl status tart-guest-agent'." >&2
  exit 1
fi
printf '%s: ok   %-22s %s\n' "$prog" "tart exec (vsock)" "responds" >&2

# tart-up escalates over the same channel for `sudo hostnamectl` on every cell,
# and for `systemctl isolate` plus the VNC unit on GUI ones — which needs the
# NOPASSWD sudoers 99-finalize installs and the agent running as a user they
# cover. The display-scale applier is the one call that stays unprivileged.
if ! sudo_err=$(tart exec "$VM" sudo -n true 2>&1); then
  echo "$prog: FAIL — 'tart exec' cannot escalate in '$VM': ${sudo_err:-no output}. tart-up sets the guest hostname on every cell and activates every GUI mode privileged over this channel, so no clone of this image would get its hostname and none could start a desktop. The agent runs as 'admin' — check the sudoers drop-in 99-finalize.sh writes." >&2
  exit 1
fi
printf '%s: ok   %-22s %s\n' "$prog" "tart exec (sudo)" "passwordless" >&2

# Read the guest's own name over the same channel. A failure here is the
# `hostname` command in the guest, not the channel — which the probe above has
# already proven — so it gets its own verdict.
# Stderr is dropped rather than merged: this value is compared for equality
# below, and anything the guest wrote to stderr while still exiting 0 would
# corrupt that into a bogus "the guest calls itself ..." verdict.
if ! agent_reply=$(tart exec "$VM" hostname -s 2>/dev/null); then
  echo "$prog: FAIL — 'hostname -s' failed inside '$VM'. The guest agent answers and can escalate, so this is the guest's own hostname command, not the vsock channel — run 'tart exec $VM hostname -s' to see what it says." >&2
  exit 1
fi

# tart-up sets this over the channel just proven, and suppresses every failure of
# that step, so a name still at the base image's default is otherwise invisible
# until the ssh assert below reports a bare mismatch — which reads as a
# provisioning bug in the image. tart-up's own comment names the two causes it
# swallows: an agent that started too late for its one probe, and a guest where
# the hostname tool itself failed — hostnamectl/systemd-hostnamed on linux,
# scutil on darwin (tart-up has no hostnamectl branch on that platform, so a
# darwin failure must not send the reader after a binary that isn't there).
hostname_tool="hostnamectl/systemd-hostnamed"
[ "$PLATFORM" = "darwin" ] && hostname_tool="scutil"
if [ "$agent_reply" != "$VM" ]; then
  echo "$prog: FAIL — the guest agent in '$VM' answers and can escalate, but the guest calls itself '${agent_reply:-empty}' rather than '$VM'. tart-up sets that over this channel and suppresses any failure, so either it probed before the agent was listening, or $hostname_tool failed in the guest. Re-run; if it repeats, it is the guest side, not timing." >&2
  exit 1
fi
printf '%s: ok   %-22s %s\n' "$prog" "guest hostname (vsock)" "$agent_reply" >&2

# BatchMode so a broken auth chain fails fast instead of hanging on a prompt.
got=$(ssh -o BatchMode=yes "tart-$VM" hostname -s) || {
  rc=$?
  # A Secure-Enclave key in require-authentication mode can't sign under
  # BatchMode — that auth failure is the key-mode trade-off of README Setup
  # §1 surfacing, not necessarily a broken image.
  echo "$prog: FAIL — ssh to 'tart-$VM' failed (rc=$rc). If your VM key requires Touch ID, see README Setup step 1; re-run with SMOKE_KEEP=1 to keep the VM for inspection." >&2
  exit "$rc"
}

# tart-up sets the guest hostname to the VM name on the boot it starts, so a
# match proves clone → boot → DHCP → sshd → auth → provisioning end-to-end —
# strictly more than "sshd answered".
if [ "$got" != "$VM" ]; then
  echo "$prog: FAIL — guest hostname: expected '$VM', got '$got' (re-run with SMOKE_KEEP=1 to keep the VM for debugging)." >&2
  exit 1
fi

# Attestation: everything above proves a VM boots and answers, not that it is the
# image that was asked for. The name is the only thing tart-new checks, and
# tart-up supplies the hostname — so a mislabeled or stale image passes all of it.
# These four read what the guest actually carries.
attest() { # <label> <want> <got>
  if [ "$2" = "$3" ]; then
    printf '%s: ok   %-22s %s\n' "$prog" "$1" "$3" >&2
  else
    echo "$prog: FAIL — $1: expected '$2', guest reports '$3' (re-run with SMOKE_KEEP=1 to inspect /etc/tart-stacks-release)." >&2
    exit 1
  fi
}
# Guest self-ID, appended to the manifest read: the point is to ask the GUEST
# what it is INDEPENDENTLY of the manifest, so a mislabeled image is caught —
# reading the manifest's own os:/os-pretty: here would attest the file
# against itself and prove nothing. macOS has no /etc/os-release; sw_vers is
# the darwin peer, lower-cased so "macOS" lines up with the lower-case OS
# tokens this repo uses everywhere else (shared/darwin/os, tart-new, tart-up).
if [ "$PLATFORM" = "darwin" ]; then
  manifest=$(ssh -o BatchMode=yes "tart-$VM" 'cat /etc/tart-stacks-release; echo "sw-vers-id: $(sw_vers -productName | tr "[:upper:]" "[:lower:]")"') || {
    rc=$?
    echo "$prog: FAIL — could not read /etc/tart-stacks-release in 'tart-$VM' (rc=$rc); the image carries no provenance to check." >&2
    exit "$rc"
  }
else
  manifest=$(ssh -o BatchMode=yes "tart-$VM" 'cat /etc/tart-stacks-release; . /etc/os-release; echo "os-id: $ID"') || {
    rc=$?
    echo "$prog: FAIL — could not read /etc/tart-stacks-release in 'tart-$VM' (rc=$rc); the image carries no provenance to check." >&2
    exit "$rc"
  }
fi
field() { printf '%s\n' "$manifest" | awk -v k="$1:" '$1==k { print $2; exit }'; }

# field() takes the FIRST match on key and exits, so a duplicate `os:` line
# would silently orphan the second instead of failing the attest below —
# the attest would read the build token and call it a day, with no signal
# that a second, unreachable line exists. Assert the key appears exactly once
# before trusting field() to read it.
os_lines=$(printf '%s\n' "$manifest" | awk '$1=="os:" { c++ } END { print c+0 }')
if [ "$os_lines" -ne 1 ]; then
  echo "$prog: FAIL — manifest has $os_lines 'os:' line(s), want exactly 1 (field() returns only the first match and exits, so a duplicate key silently orphans the rest — inspect /etc/tart-stacks-release)." >&2
  exit 1
fi
printf '%s: ok   %-22s %s\n' "$prog" "manifest os: key" "unique" >&2

attest "manifest stack"  "$STACK"          "$(field stack)"
attest "manifest os" "$OS"                 "$(field os)"
if [ "$PLATFORM" = "darwin" ]; then
  attest "guest sw_vers id" "$OS"          "$(field sw-vers-id)"
else
  attest "guest os-release id" "$OS"       "$(field os-id)"
fi
# darwin's manifest carries no gui: key at all — the macOS desktop is
# intrinsic, so 99-finalize.sh (darwin) has no GUI axis to record, unlike the
# linux peer, which always writes gui: <de>|none. Nothing to attest there.
if [ "$PLATFORM" != "darwin" ]; then
  attest "manifest gui"    "${DE:-none}"     "$(field gui)"
fi

# The toolchain has to be reachable the way an agent or a script reaches it: a
# login shell with no rc file, which is what `ssh <vm> <cmd>` runs.
#
# The probe commands are DATA, per stack, for the same reason packages.<family>
# is: a two-way `php or else java` fork silently probes a third stack for the
# wrong runtime, and it can only ever cover the one command it hardcodes. They
# come from the proof column of the stack's tool declaration — the same rows
# the build-time smoke_gate is held to (test/declaration.sh enforces that
# equality), so what this loop proves at runtime is exactly what the build
# gated, with no second list to drift. Only `tool` rows probe; `ext` rows are
# build-time membership claims with no runtime command.
TOOLS_FILE="$REPO/stacks/$STACK/tools"
if [ ! -f "$TOOLS_FILE" ]; then
  echo "$prog: FAIL — no tool declaration at stacks/$STACK/tools, so there is nothing to prove about this stack's toolchain (make scaffold stamps one; add a row per tool)." >&2
  exit 1
fi
probes=$(awk -F'|' '$1 == "tool" { print $3 "|" $5 }' "$TOOLS_FILE")
if [ -z "$probes" ]; then
  echo "$prog: FAIL — stacks/$STACK/tools declares no tool rows, so 'toolchain' below would pass without probing anything." >&2
  exit 1
fi
# Counted from the file, compared after the loop — defense in depth: the
# binary|proof lines are nonblank even with an empty proof, but the count
# guard survives any future format change that reintroduces strippable
# lines into the command substitution.
n_rows=$(awk -F'|' '$1 == "tool"' "$TOOLS_FILE" | wc -l | tr -d ' ')
n_probed=0
while IFS='|' read -r binary probe; do
  # A tool row whose proof column is empty or whitespace-only would hand ssh
  # a blank command, which a login shell exits 0 on — a green with nothing
  # probed. Refuse it here even though test/declaration.sh also rejects the
  # row shape: this script must not depend on another check having run.
  case "$probe" in
    *[![:space:]]*) ;;
    *)
      echo "$prog: FAIL — a tool row in stacks/$STACK/tools has an empty or whitespace-only proof column; a blank ssh command exits 0 without probing anything." >&2
      exit 1 ;;
  esac
  # The proof must be plain argv words — no shell syntax. Without this, a
  # prefix like `uv --version; true` matches the binary check below and the
  # `true` masks a missing tool; the static suite rejects the shape too, but
  # this script's verdict must not depend on another check having run.
  case "$probe" in
    *[!A-Za-z0-9._+=/:@\ -]*)
      echo "$prog: FAIL — the proof '$probe' in stacks/$STACK/tools contains shell syntax; proofs are argv words only, so nothing can mask the probed command's own exit status." >&2
      exit 1 ;;
  esac
  # And it must exercise the row's own binary — either executing it
  # (argv[0]) or the blessed existence form `command -v <binary>` — or it
  # certifies nothing about the tool.
  case "$probe" in
    "$binary"|"$binary "*|"command -v $binary") ;;
    *)
      echo "$prog: FAIL — the proof '$probe' does not exercise its row's binary '$binary' (stacks/$STACK/tools); a proof that runs something else certifies nothing about the tool." >&2
      exit 1 ;;
  esac
  # -n: ssh reads stdin by default, which here is the probe list feeding this
  # very loop — without it the first probe consumes the rest and only one tool
  # is ever checked.
  if ssh -n -o BatchMode=yes "tart-$VM" "$probe" >/dev/null 2>&1; then
    printf '%s: ok   %-22s %s\n' "$prog" "non-interactive" "$probe" >&2
    n_probed=$((n_probed + 1))
  else
    echo "$prog: FAIL — '$probe' does not work over a non-interactive ssh, so the image's PATH wiring is broken for scripts and agents." >&2
    exit 1
  fi
done <<< "$probes"
if [ "$n_probed" -ne "$n_rows" ]; then
  echo "$prog: FAIL — stacks/$STACK/tools has $n_rows tool row(s) but only $n_probed probe(s) ran — a row with an empty or malformed proof column was silently dropped." >&2
  exit 1
fi

# The hardening posture 99-finalize establishes, read from sshd's own effective
# config rather than from the drop-in file it was written into.
sshd_effective=$(ssh -o BatchMode=yes "tart-$VM" 'sudo sshd -T 2>/dev/null || sudo /usr/sbin/sshd -T' 2>/dev/null) || sshd_effective=""
if [ -z "$sshd_effective" ]; then
  echo "$prog: FAIL — could not read sshd's effective config in 'tart-$VM'; the hardening posture is unverified." >&2
  exit 1
fi
for want in "passwordauthentication no" "permitrootlogin no" "kbdinteractiveauthentication no" "streamlocalbindunlink yes"; do
  if printf '%s\n' "$sshd_effective" | grep -qix "$want"; then
    printf '%s: ok   %-22s %s\n' "$prog" "sshd -T" "$want" >&2
  else
    echo "$prog: FAIL — sshd's effective config lacks '$want' in 'tart-$VM' (got: $(printf '%s\n' "$sshd_effective" | grep -i "^${want%% *} " || echo 'nothing'))." >&2
    exit 1
  fi
done

# The closing platform-specific surface check. Exactly one arm applies: a
# linux GUI flavor gets the VNC surface below; every darwin run (which never
# carries a <de> — refused up front) gets the listener-surface + Screen
# Sharing check in the elif; a headless linux run gets neither.
#
# GUI flavor: the desktop surface IS what a GUI smoke proves — start the baked
# VNC unit (deliberately not enabled in the image, so this also exercises the
# activation path a consumer uses) and read the RFB banner off the loopback
# listener. Runs after the hostname assert so the plain SSH chain is already
# proven when this stage fails.
if [ -n "$DE" ]; then
  ssh -o BatchMode=yes "tart-$VM" "sudo systemctl start tart-stacks-vnc.service" || {
    rc=$?
    echo "$prog: FAIL — tart-stacks-vnc.service failed to start (rc=$rc); re-run with SMOKE_KEEP=1 and inspect 'systemctl status tart-stacks-vnc' in the VM." >&2
    exit "$rc"
  }
  # A forking start returns once the session starter daemonizes; give Xvnc's
  # listener a few beats before calling the surface broken. The knobs are the
  # test seam (mocked runs set delay 0).
  tries="${SMOKE_VNC_TRIES:-5}"
  banner=""
  while [ "$tries" -gt 0 ]; do
    banner=$(ssh -o BatchMode=yes "tart-$VM" "timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/5901 && head -c 3 <&3'" 2>/dev/null) && [ -n "$banner" ] && break
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] && sleep "${SMOKE_VNC_DELAY:-2}"
  done
  if [ "$banner" != "RFB" ]; then
    echo "$prog: FAIL — no RFB banner on 127.0.0.1:5901 inside 'tart-$VM' (got '${banner:-nothing}') — the VNC session did not come up (re-run with SMOKE_KEEP=1 to inspect)." >&2
    exit 1
  fi
  # The banner probe alone cannot see the security boundary: it dials
  # 127.0.0.1 and so answers identically whether Xvnc bound loopback or
  # 0.0.0.0 — it passes in exactly the failure case. The unit ships
  # SecurityTypes=None, so the loopback bind IS the authentication; assert the
  # listener's actual address, which is the only thing that distinguishes a
  # confined desktop from one exposed to the VM's network.
  #
  # The read is captured on its own so a failed `ss` cannot be reported as
  # "nothing is listening": under set -o pipefail it would abort the assignment
  # instead, and the two states need different verdicts — one is a defective
  # image, the other an unverified one.
  if ! listener_table=$(ssh -o BatchMode=yes "tart-$VM" "ss -tln 2>/dev/null || sudo ss -tln" 2>/dev/null); then
    echo "$prog: FAIL — could not read the guest TCP listener table with ss inside 'tart-$VM', so the VNC bind is unverified (re-run with SMOKE_KEEP=1 and try 'ss -tln' in the VM)." >&2
    exit 1
  fi
  listeners=$(printf '%s\n' "$listener_table" | awk '$4 ~ /:5901$/ { print $4 }')
  if [ -z "$listeners" ]; then
    echo "$prog: FAIL — nothing listening on :5901 inside 'tart-$VM' after the RFB banner answered (re-run with SMOKE_KEEP=1 to inspect)." >&2
    exit 1
  fi
  # An allowlist, per line — the classifier tart-up already applies at boot.
  # Enumerating the wildcard spellings instead accepts a bind to the VM's own
  # address (192.168.64.7:5901), which is exposure too.
  while IFS= read -r addr; do
    case "$addr" in
      127.0.0.1:5901|'[::1]:5901') ;;
      *)
        echo "$prog: FAIL — VNC on 'tart-$VM' is bound beyond loopback ($addr). The unit uses no VNC password, so a non-loopback bind is an unauthenticated desktop on the VM's network." >&2
        exit 1 ;;
    esac
  done <<< "$listeners"
elif [ "$PLATFORM" = "darwin" ]; then
  # darwin has no guest-side VNC listener at all (tart-up serves it host-side
  # via Tart's own --vnc-experimental — see bin/tart-up), so there is no
  # guest surface to probe here the way linux's VNC unit is probed above.
  # What replaces it: the runtime peer of 99-finalize.sh's build-time
  # ":22 alone" assertion. That one runs once, on the builder VM, before the
  # image is ever imaged and cloned; this one runs against a booted CLONE, so
  # a pass proves the posture survived imaging and cloning, not merely that
  # it was once true at build time. Same netstat|awk idiom 99-finalize.sh
  # uses — `ss` does not exist on macOS.
  if ! listener_table=$(ssh -o BatchMode=yes "tart-$VM" 'sudo netstat -an -p tcp' 2>/dev/null); then
    echo "$prog: FAIL — could not read the guest TCP listener table in 'tart-$VM' with netstat, so the :22-alone posture and Screen Sharing's absence are both unverified (re-run with SMOKE_KEEP=1 and try 'sudo netstat -an -p tcp' in the VM)." >&2
    exit 1
  fi
  # Parse each LISTEN row into "addr port": netstat renders the Local Address
  # column address-and-port joined by a dot (`127.0.0.1.4445`, `::1.4445`,
  # `*.22` — measured directly against the real binary; IPv6 is NOT
  # bracketed here, unlike ss's `[::1]:5901` the linux VNC stage parses
  # below) — an IPv4 address embeds three more dots of its own, so only the
  # LAST dot is the port separator; `sub()`'s greedy `.*\.` match finds it
  # regardless of how many dots came before.
  rows=$(printf '%s\n' "$listener_table" | awk '
    $NF == "LISTEN" {
      addr = $4; port = $4
      sub(/\.[^.]*$/, "", addr)
      sub(/.*\./, "", port)
      print addr, port
    }' | sort -u)
  ports=$(printf '%s\n' "$rows" | awk '{ print $2 }' | sort -u)
  # must-pass control: :22 has to show up in the parsed set on its own, or an
  # empty/broken read (netstat itself failing, a parse that matches nothing)
  # would pass everything below vacuously — "nothing unexpected" and "5900
  # absent" are both trivially true of a table with nothing in it at all.
  if ! printf '%s\n' "$ports" | grep -qx 22; then
    echo "$prog: FAIL — the guest listener table in 'tart-$VM' never showed :22 itself (got: $(printf '%s' "$ports" | tr '\n' ' ')) — this read is not trustworthy evidence for the checks below (re-run with SMOKE_KEEP=1 and try 'sudo netstat -an -p tcp' in the VM)." >&2
    exit 1
  fi
  printf '%s: ok   %-22s %s\n' "$prog" "listener table" "22 present (must-pass control)" >&2

  # This platform's central security claim, read from the SAME already
  # must-pass-verified table rather than a fresh host-side connect probe: a
  # bare connect only proves a TCP handshake succeeded or failed, and a
  # socket bound with nothing behind it still answers a connect — the exact
  # false positive this repo's probe-quality bar rules out. The kernel
  # LISTEN-state row read here is unambiguous either way, regardless of
  # whether anything on the other end would ever speak RFB. Unconditional on
  # bind address, unlike the general check below: nothing legitimately
  # forwards a tunnel onto :5900, so any appearance of it — loopback or not —
  # is the base's disabled service coming back.
  if printf '%s\n' "$ports" | grep -qx 5900; then
    echo "$prog: FAIL — port 5900 (Screen Sharing) is listening on 'tart-$VM' — the base ships it reachable with the publicly-known admin/admin password, and 99-finalize.sh is supposed to disable it." >&2
    exit 1
  fi
  printf '%s: ok   %-22s %s\n' "$prog" "screen sharing" "absent (:5900 not listening)" >&2

  # The claim worth asserting AT RUNTIME is "no listener beyond :22 reachable
  # from outside the guest" — not "no listener beyond :22, full stop". The
  # two differ deliberately: 99-finalize.sh's build-time assert (the one it
  # runs) stays absolute. Not because the build has no ssh session — Packer's
  # own communicator session is open the entire time — but because a session
  # without RemoteForwards binds no listener, and Packer requests none. This
  # check runs against a
  # live clone the OPERATOR is (or was) ssh'd into, and a `Host tart-*
  # RemoteForward …` in ~/.config/tart-stacks/forwards makes sshd-sess bind
  # the forwarded port on the GUEST's loopback for the life of that session —
  # real sockets, not a mocking artifact, and not exposure: nothing outside
  # the guest can reach 127.0.0.1 or ::1 inside it. Do not tighten this back
  # to the build-time script's bar; that reintroduces a false FAIL that is
  # invisible in the mocked suite and CI (no forwards there) and fires only
  # for the operator this whole check exists to protect. The allowlist below
  # is NOT the same spelling the linux VNC stage's loopback classifier uses
  # (`[::1]:5901`, bracketed) — that one parses `ss`, this one parses
  # macOS's `netstat`, and the two tools render IPv6 loopback differently
  # for the identical concept; each classifier matches its own tool's real
  # output, not each other's.
  non_loopback=$(printf '%s\n' "$rows" | awk '
    $2 != "22" {
      addr = $1
      if (addr != "127.0.0.1" && addr != "::1") print addr":"$2
    }')
  if [ -n "$non_loopback" ]; then
    echo "$prog: FAIL — 'tart-$VM' has a non-loopback listener beyond :22 ($(printf '%s' "$non_loopback" | tr '\n' ' ')) — a loopback bind (127.0.0.1 / ::1) is tolerated as the operator's own RemoteForward tunnel, but this is reachable beyond the guest itself." >&2
    exit 1
  fi
  printf '%s: ok   %-22s %s\n' "$prog" "listener surface" ":22 alone beyond loopback (survived clone)" >&2
fi

if [ "$PLATFORM" = "darwin" ]; then
  id_stage="sw_vers"
  closing_stage=", listener surface, screen sharing"
else
  id_stage="os-release"
  closing_stage="${DE:+, vnc}"
fi
echo "$prog: OK — $OS-$STACK${DE:+-$DE} smoke passed: clone, boot, guest agent, ssh, hostname, manifest, $id_stage, toolchain, sshd posture$closing_stage." >&2
