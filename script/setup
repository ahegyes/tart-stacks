#!/usr/bin/env bash
# setup — one-time host install for tart-stacks. Run via `make setup`
# (or directly: script/setup). Symlinks the commands onto PATH, installs
# zsh completion, wires the SSH Include line, scaffolds the per-VM
# forwards and mounts files, and finishes by generating the included SSH
# config via tart-ssh-sync (when Tart is installed — without it the skip
# is warned loudly, since `ssh tart-<name>` cannot resolve until a sync).
#
# Idempotent: safe to re-run. It only creates what's missing and never
# overwrites your edits. Where it can't safely fix something (an Include
# placed below a catch-all `Host *`, which SSH's first-match-wins renders
# dead), it WARNS and leaves the file untouched rather than rewriting it.
#
# `--uninstall` (also: `make uninstall`) is the inverse. It removes only
# what verifiably points into this repo, strips only the exact Include
# block setup writes, and keeps every per-VM config file (forwards, mounts,
# gui, ssh-agents, netpolicy — they carry your opt-ins).
#
# Override targets via env (non-default host layouts, or to sandbox a run):
#   TART_LOCAL_BIN         command symlink dir       (default ~/.local/bin)
#   TART_COMPDIR           zsh completion dir        (default: brew site-functions, else ~/.local/share/zsh/site-functions)
#   TART_SSH_CONFIG        ssh config to wire        (default ~/.ssh/config)
#   TART_FORWARDS          per-VM forwards to scaffold (default ~/.config/tart-stacks/forwards)
#   TART_MOUNTS            per-VM dir mounts to scaffold (default ~/.config/tart-stacks/mounts)
#   TART_SSH_CONFIG_D      generated ssh config        (default ~/.ssh/config.d/tart-vms)

set -euo pipefail

# resolve_link <path> — print <path> with each symlink in its own position
# followed; a path that does not exist prints unchanged. `readlink -f` would be
# one call, but it fails outright on a nonexistent path — and ~/.ssh/config
# legitimately may not exist yet when this runs. The hop cap is what stops a
# symlink cycle spinning here forever with no output: this runs on a
# user-supplied path, and 40 hops is far past any real dotfiles chain. Returns
# nonzero rather than exiting, so a caller's `$( )` cannot swallow the refusal.
resolve_link() {
  local p="$1" dir hops=0
  while [ -L "$p" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
      echo "setup: '$1' is a symlink loop (unresolved after $((hops - 1)) hops) — fix the link and re-run." >&2
      return 1
    fi
    dir=$(cd -P "$(dirname "$p")" >/dev/null 2>&1 && pwd)
    p=$(readlink "$p")
    case "$p" in /*) ;; *) p="$dir/$p" ;; esac
  done
  printf '%s' "$p"
}

# This script lives in the repo's script/; resolve its real path (following
# symlinks), step up to the repo root, and point BIN_DIR at the actual
# commands in bin/ — so the symlinks target the repo no matter where setup
# was invoked from. Two steps, not one nested substitution: nested, a refusal
# from resolve_link would leave `dirname` an empty string and SCRIPT_DIR the cwd.
self=$(resolve_link "${BASH_SOURCE[0]}") || exit 1
SCRIPT_DIR=$(cd -P "$(dirname "$self")" >/dev/null 2>&1 && pwd)
REPO_DIR=$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)
BIN_DIR="$REPO_DIR/bin"
# shellcheck source=bin/lib/config.sh
# bin/lib/ ships with the bins and is sourced via each script's symlink-resolved
# real dir — it is never symlinked onto PATH.
. "$BIN_DIR/lib/config.sh"

LOCAL_BIN="${TART_LOCAL_BIN:-$HOME/.local/bin}"
# Symlinks resolved up front so every write below, and the chmod, land on the
# real file: `mv` renames over a LINK, which would detach a dotfiles-managed
# ~/.ssh/config from its repo while ssh went on reading the replacement.
SSH_CONFIG=$(resolve_link "${TART_SSH_CONFIG:-$HOME/.ssh/config}") || exit 1
FORWARDS=$(tart_config_path forwards)
MOUNTS=$(tart_config_path mounts)
# tart-ssh-sync's output path (same default and env seam as that script): the
# install's closing sync writes it, the uninstall removes it.
GENERATED="${TART_SSH_CONFIG_D:-$HOME/.ssh/config.d/tart-vms}"

# The Include block, line by line. Install writes exactly these three lines
# plus a blank separator; uninstall removes exactly that four-line shape and
# nothing else. Shared constants keep the two directions from drifting.
#
# The target is derived from GENERATED so the Include always names the file the
# sync actually writes, which is what makes TART_SSH_CONFIG_D a real override.
# `~` while the path is under $HOME: ssh expands it, and it keeps a config that
# gets read by hand portable across accounts.
# shellcheck disable=SC2088  # ssh expands the tilde; this shell must not
case "$GENERATED" in
  "$HOME"/*) INCLUDE_TARGET="~/${GENERATED#"$HOME"/}" ;;
  *)         INCLUDE_TARGET="$GENERATED" ;;
esac
INCLUDE_LINE="Include $INCLUDE_TARGET"
# ssh_config(5) resolves a bare relative Include against ~/.ssh, so
# `Include config.d/tart-vms` is a third legal spelling of the same file.
# Recognising all three is what stops setup adding a second Include beside a
# hand-written one — two Includes of the generated file make the auto-start hook
# fire twice per login.
case "$GENERATED" in
  "$HOME"/.ssh/*) INCLUDE_TARGET_REL="${GENERATED#"$HOME"/.ssh/}" ;;
  *)              INCLUDE_TARGET_REL="$INCLUDE_TARGET" ;;
esac
MARKER_LINE="# Added by tart-stacks. Run 'make setup' to restore this line if removed."
KEEP_ABOVE_LINE='# Keep it above any Host block so per-VM settings beat a catch-all Host *.'

# Commands symlinked onto PATH — install and uninstall iterate the same list.
COMMANDS=(tart-up tart-ssh-sync tart-new tart-rm tart-down)

info() { printf '  %s\n' "$*"; }
warn() { printf '  WARNING: %s\n' "$*" >&2; }

# ours_or_absent <path> <target> — 0 when <path> is absent or is already our
# symlink to <target>, so the caller may (re)link it. Otherwise warns and
# returns 1: an installer must not silently destroy something it didn't create.
ours_or_absent() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    if [ ! -L "$1" ] || [ "$(readlink "$1")" != "$2" ]; then
      warn "left $1 — it is not this repo's symlink; remove it yourself and re-run setup."
      return 1
    fi
  fi
  return 0
}

# include_scan <file> — print four line numbers, 0 each for "not found":
#   <first Host/Match>  <block enclosing our Include>  <first catch-all above it>  <our Include>
#
# The Include's path is matched as a whole field against the three spellings ssh
# accepts for the generated file, so a neighbour like `…/tart-vms-extra` is never
# mistaken for ours. The other three numbers are what the placement verdict needs:
# an Include below the first Host/Match is nested in that block, and whether a
# catch-all sits above it decides whether ssh skips the Include entirely or reads
# it and then discards its keywords.
include_scan() {
  awk -v t1="$INCLUDE_TARGET" -v t2="$GENERATED" -v t3="$INCLUDE_TARGET_REL" '
    tolower($1)=="host" || tolower($1)=="match" {
      if (!inc) {
        if (!first) first=NR
        enclosing=NR
        if (!catchall) {
          if (tolower($1)=="host") { for (i=2; i<=NF; i++) if ($i=="*") catchall=NR }
          else if (tolower($2)=="all") catchall=NR
        }
      }
    }
    tolower($1)=="include" && !inc {
      for (i=2; i<=NF; i++) if ($i==t1 || $i==t2 || $i==t3) { inc=NR; break }
    }
    END { print first+0, enclosing+0, catchall+0, inc+0 }
  ' "$1"
}

usage() {
  cat >&2 <<EOF
usage: script/setup              install the host tools (default; idempotent)
       script/setup --uninstall  remove them (per-VM config files are kept)
EOF
}

# Create a per-VM config file from this function's stdin, idempotently — only
# writes when the file is missing, so re-runs never clobber your edits.
scaffold() {
  local path="$1" label="$2"
  if [ -e "$path" ]; then
    info "$label already present ($path) — left as-is."
    return 0
  fi
  mkdir -p "$(dirname "$path")"
  cat > "$path"
  info "scaffolded $path."
}

MODE=install
case "${1:-}" in
  '') ;;
  --uninstall) MODE=uninstall ;;
  -h|--help)   usage; exit 0 ;;
  *) echo "setup: unknown arg '$1'" >&2; usage; exit 64 ;;
esac

# zsh completion dir, resolved up front because both directions need it.
# Homebrew's site-functions is already on fpath; the home-dir fallback is not,
# so the install tells the user to wire it.
compdir="${TART_COMPDIR:-}"
if [ -z "$compdir" ]; then
  if command -v brew >/dev/null 2>&1; then
    compdir="$(brew --prefix)/share/zsh/site-functions"
  else
    compdir="$HOME/.local/share/zsh/site-functions"
  fi
fi

# ---- uninstall ---------------------------------------------------------------

if [ "$MODE" = "uninstall" ]; then
  echo "setup: uninstalling host tools (repo at $REPO_DIR)"
  summary=""
  add_summary() { summary="${summary:+$summary, }$1"; }

  # 1. Command symlinks — removed only when one still resolves into this
  #    repo's bin/; a same-named file from anywhere else is not ours to touch.
  unlinked=()
  for name in "${COMMANDS[@]}"; do
    link="$LOCAL_BIN/$name"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$BIN_DIR/$name" ]; then
      rm -f "$link"
      unlinked+=("$name")
    elif [ -e "$link" ] || [ -L "$link" ]; then
      warn "left $link — it does not point into $BIN_DIR."
    fi
  done
  if [ "${#unlinked[@]}" -gt 0 ]; then
    info "unlinked ${unlinked[*]} from $LOCAL_BIN."
    add_summary "${#unlinked[@]} command symlink(s)"
  fi

  # 2. Completion symlink, same ownership test.
  comp_link="$compdir/_tart-new"
  if [ -L "$comp_link" ] && [ "$(readlink "$comp_link")" = "$REPO_DIR/completions/_tart-new" ]; then
    rm -f "$comp_link"
    info "unlinked completion (_tart-new) from $compdir."
    add_summary "completion"
  elif [ -e "$comp_link" ] || [ -L "$comp_link" ]; then
    warn "left $comp_link — it does not point into $REPO_DIR."
  fi

  # 3. The Include block — only when the marker comment vouches it's ours, and
  #    only the exact four-line shape the install writes; every other line of
  #    the file is preserved (a missing EOF newline is normalized — awk prints
  #    whole lines). An unmarked Include is hand-written: warn, leave.
  if [ -f "$SSH_CONFIG" ] && grep -qxF "$MARKER_LINE" "$SSH_CONFIG"; then
    tmp=$(mktemp "${SSH_CONFIG}.XXXXXX")
    if awk -v m="$MARKER_LINE" -v k="$KEEP_ABOVE_LINE" -v inc="$INCLUDE_LINE" '
      { l[NR] = $0 }
      END {
        at = 0
        for (i = 1; i + 3 <= NR; i++)
          if (l[i] == m && l[i+1] == k && l[i+2] == inc && l[i+3] == "") { at = i; break }
        if (!at) exit 3   # 3: clear of awk(1) own 1/2 exit codes
        for (i = 1; i <= NR; i++)
          if (i < at || i > at + 3) print l[i]
      }
    ' "$SSH_CONFIG" > "$tmp"; then
      mv "$tmp" "$SSH_CONFIG"
      chmod 600 "$SSH_CONFIG"
      info "removed the tart-stacks Include block from $SSH_CONFIG."
      add_summary "SSH Include block"
    else
      rm -f "$tmp"
      warn "marker comment found in $SSH_CONFIG but the block shape has drifted from what setup writes — left unchanged; remove the Include by hand."
    fi
  elif [ -f "$SSH_CONFIG" ]; then
    read -r _ _ _ unmarked_inc < <(include_scan "$SSH_CONFIG")
    if [ "$unmarked_inc" -gt 0 ]; then
      warn "the Include on line $unmarked_inc of $SSH_CONFIG carries no tart-stacks marker comment — it looks hand-written, so it was left in place."
    fi
  fi

  # 4. tart-ssh-sync output (plus a failed candidate, if one survived) — pure
  #    generated state, recreated by the next sync.
  for f in "$GENERATED" "${GENERATED}.rejected"; do
    if [ -e "$f" ]; then
      rm -f "$f"
      info "removed $f."
      add_summary "${f##*/}"
    fi
  done

  # 5. forwards/mounts/gui/ssh-agents/netpolicy stay: they carry your opt-ins
  #    (gui, ssh-agents, and netpolicy may even be written by external tooling).
  info "kept the per-VM config files in $(tart_config_dir) (forwards, mounts, gui, ssh-agents, netpolicy)."

  echo "setup: uninstall done — removed ${summary:-nothing (nothing of ours was present)}. Reinstall anytime with:  make setup"
  exit 0
fi

# ---- install -----------------------------------------------------------------

echo "setup: installing host tools from $REPO_DIR"

# 1. Symlink the commands onto PATH. Ownership-checked like the uninstall:
#    our own links (and prior copies of them) are replaced, but a foreign
#    file or symlink squatting on a command name is warned about and left —
#    an installer must not silently destroy something it didn't create.
mkdir -p "$LOCAL_BIN"
linked=()
for name in "${COMMANDS[@]}"; do
  target="$LOCAL_BIN/$name"
  ours_or_absent "$target" "$BIN_DIR/$name" || continue
  ln -sf "$BIN_DIR/$name" "$target"
  linked+=("$name")
done
if [ "${#linked[@]}" -gt 0 ]; then
  info "linked ${linked[*]} -> $LOCAL_BIN"
fi
case ":$PATH:" in
  *":$LOCAL_BIN:"*) ;;
  *) warn "$LOCAL_BIN is not on your \$PATH — add it so the commands resolve." ;;
esac

# 2. zsh completion — ownership-checked exactly like the commands above. The
#    uninstall already refuses to remove a foreign file on this name, so
#    clobbering one here would delete a user's completion and leave the
#    replacement behind for `make uninstall` to take away.
mkdir -p "$compdir"
if ours_or_absent "$compdir/_tart-new" "$REPO_DIR/completions/_tart-new"; then
  ln -sf "$REPO_DIR/completions/_tart-new" "$compdir/_tart-new"
  info "linked completion (_tart-new) -> $compdir  (run: rm -f ~/.zcompdump* && exec zsh)"
  case "$compdir" in
    "$HOME"/*) warn "add to ~/.zshrc above compinit:  fpath=($compdir \$fpath)" ;;
  esac
fi

# 3. SSH Include line — idempotent, and validated for placement. One rule covers
#    both ways placement goes wrong: the Include must sit above the FIRST
#    `Host`/`Match` line. Verified with `ssh -G` on OpenSSH 10.2 — below a scoped
#    block ssh reads the Include only for the hosts that block matches, so the
#    Tart settings never reach a tart-* alias; below a catch-all it reads them
#    and then keeps the catch-all's value for every keyword they share.
mkdir -p "$(dirname "$SSH_CONFIG")"
touch "$SSH_CONFIG"
chmod 600 "$SSH_CONFIG"
read -r firstblock enclosing catchall inc < <(include_scan "$SSH_CONFIG")
if [ "$inc" -gt 0 ]; then
  if [ "$firstblock" -gt 0 ] && [ "$inc" -gt "$firstblock" ]; then
    if [ "$catchall" -gt 0 ]; then
      warn "Include is on line $inc, below the catch-all that starts on line $catchall."
      warn "First-match-wins means the catch-all overrides the Tart VM settings (e.g. wrong User)."
    else
      warn "Include is on line $inc, inside the block that starts on line $enclosing."
      warn "ssh reads a nested Include only for the hosts that block matches, so it never applies to tart-* aliases."
    fi
    warn "Move '$INCLUDE_LINE' above line $firstblock. Left unchanged."
  else
    info "SSH Include already present and correctly placed (line $inc)."
  fi
else
  tmp=$(mktemp "${SSH_CONFIG}.XXXXXX")
  {
    printf '%s\n' \
      "$MARKER_LINE" \
      "$KEEP_ABOVE_LINE" \
      "$INCLUDE_LINE" \
      ''
    cat "$SSH_CONFIG"
  } > "$tmp"
  mv "$tmp" "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  info "added SSH Include to the top of $SSH_CONFIG."
fi

# 4. Per-VM forwards opt-ins (never touches an existing file).
scaffold "$FORWARDS" "forwards file" <<'EOF'
# tart-stacks per-VM RemoteForward opt-ins. Re-run tart-ssh-sync after editing.
# Format:  <vm-pattern> RemoteForward <args>
#   <vm-pattern>:  *  (all VMs) | <vm> | <a>,<b>,...  (comma list, no spaces)
# Example:
#   * RemoteForward 27123 127.0.0.1:27123   # forward a host service into every VM
EOF

# 5. Per-VM directory mounts (never touches an existing file).
scaffold "$MOUNTS" "mounts file" <<'EOF'
# tart-stacks per-VM directory mounts (virtiofs). Attached at VM boot when an
# interactive `ssh tart-<name>` starts a stopped VM, so they apply only on that
# start (an already-running VM won't gain them until a stop + start).
# Format:  <vm-pattern> [<name>=]<host-path>[:ro]
#   <vm-pattern>:  *  (all VMs) | <vm> | <a>,<b>,...  (comma list, no spaces)
#   <name>=        optional in-VM share name (default: <host-path> basename);
#                  mounts at /mnt/shared/<name> — set it when two shares would
#                  collide on basename
#   <host-path>:   absolute path on the host
#   :ro            optional — mount read-only
# Example:
#   * /Users/me/src/dotfiles:ro    # -> /mnt/shared/dotfiles in every VM, read-only
#   * cfg=/Users/me/.config/app    # rename the share -> /mnt/shared/cfg
EOF

# 6. Preflight — warn-only: pieces the commands depend on that this script
#    can't install for you. The install above stands either way, so neither
#    check changes the exit code.
if [ ! -e "$HOME/.ssh/tart-vm.pub" ]; then
  warn "no ~/.ssh/tart-vm.pub — every stack build bakes that key in and the generated SSH config pins it. Create + link it first: README, Setup step 1."
fi
if ! command -v jq >/dev/null 2>&1; then
  warn "jq not found — tart-new, tart-up, tart-rm and tart-down all require it. Install: brew install jq"
fi

# 7. Generate the SSH config the Include points at. OpenSSH silently ignores
#    a missing Include target and tart-ssh-sync is its only writer, so without
#    this first sync a fresh install dead-ends at "Could not resolve hostname".
if command -v tart >/dev/null 2>&1; then
  "$BIN_DIR/tart-ssh-sync"
  info "generated $GENERATED (tart-ssh-sync)."
else
  warn "Tart is not installed, so the SSH config the Include points at was NOT generated — ssh tart-<name> cannot resolve yet."
  warn "Install Tart (brew install cirruslabs/cli/tart), then run:  tart-ssh-sync"
fi

echo "setup: done. Build a stack with:  make build STACK=php DISTRO=fedora"
