# Tool versions for __STACK__. mise-install.sh installs these; this file is
# uploaded to ~/.config/mise/config.toml. Pin build-expensive or RC-prone runtimes
# to an exact version; float the rest ("lts" / "latest").
[tools]
node = "lts"

[settings]
# Corepack shims land after every node install, not just the global one, so a
# project-pinned node gets pnpm/yarn too — for Nodes that still bundle
# Corepack (24 and earlier); mise's enable is conditional on the corepack
# executable existing in that install, and Node 25+ ships without it.
node.corepack = true
