#!/usr/bin/env bash
# mise-install.sh (__STACK__, darwin) — install the runtimes declared in
# files/mise.toml as the unprivileged build user, then HARD-GATE the build on
# a smoke test, exactly like the linux peer at ../linux/mise-install.sh. Add
# the __STACK__ payload here; if a runtime compiles from source, its native
# build deps come from packages.brew (Homebrew formula names) via
# 00-stack.sh, and Homebrew keeps some formulas "keg-only" — their .pc files
# live under their own opt/ prefix instead of the shared one pkg-config
# searches by default — so a from-source build may need PKG_CONFIG_PATH
# pointed at $(brew --prefix <formula>)/lib/pkgconfig explicitly. The shared
# mechanism (install/activate, smoke loop) is in /tmp/mise-lib.sh, uploaded by
# the Packer template.

set -euo pipefail
# /tmp/mise-lib.sh is staged on the guest by the Packer template (absent at lint time).
# shellcheck source=/dev/null
source /tmp/mise-lib.sh

# Homebrew's bin dir isn't guaranteed on PATH for a script Packer invokes
# directly rather than through a login shell.
export PATH="/opt/homebrew/bin:$PATH"

mise_runtime_setup

# Smoke test (hard gate): one `--`-delimited group per tool row in the
# stack's `tools` declaration — argv tokens, not a quoted string.
# test/declaration.sh holds this call to set equality with those rows, so
# add the row and the group together. The corepack/pnpm/yarn groups are
# deliberate tripwires: mise_runtime_setup's corepack block skips silently
# when Corepack is absent, and Node 25+ no longer bundles it — this gate
# fails the build loudly when mise's `lts` alias floats past 24.
smoke_gate "__STACK__ runtimes" \
  -- node --version \
  -- corepack --version \
  -- command -v pnpm \
  -- command -v yarn

echo "==> mise-install.sh (__STACK__) complete."
